# 本地联调订阅/留言接口时使用（npx wrangler pages dev dist）
# 线上请用 `npx wrangler pages secret put <变量名>` 配置，不要把真实密钥提交进仓库

# 必填：Resend 发信密钥，没有它收不到任何邮件
RESEND_API_KEY=

# 必填：站长邮箱。留言和新订阅通知都发到这里，前端不可见
CONTACT_TO=

# 必填：发件人，形如 "波王之家 <noreply@yourdomain.com>"
MAIL_FROM=

# 可选：设为 off 关闭「新订阅」通知邮件
SUBSCRIBE_NOTIFY=

# 可选：订阅成功后转发到该 webhook
FORWARD_WEBHOOK_URL=
