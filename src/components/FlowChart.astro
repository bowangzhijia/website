---
/**
 * 上证指数 K 线（全历史）+ 宽基资金流柱状图（可缩放、可拖动）。
 *
 * K 线固定是上证指数，不跟按钮走——按钮只切换下面的资金流看哪个篮子。
 * 上证指数从 1990 年至今有 8000 多根 K 线，但 ETF 份额只有最近一年，
 * 所以柱子在早期是空的，往右拖到近一年才有。
 *
 * 用 ECharts 的 dataZoom：底部滑块拖动、滚轮缩放、按住平移。
 */
interface Props {
  data: any;
}

const { data } = Astro.props;
const hasKline = Array.isArray(data?.kline) && data.kline.length > 0;
const baskets: any[] = data?.baskets ?? [];
---

{
  hasKline && (
    <section class="fc" data-flowchart>
      <div class="fc__head">
        <h2 class="fc__h">上证指数 vs 宽基资金流</h2>
        <p class="fc__sub">
          上面是<strong>上证指数</strong> K 线（成立以来全部，可切日/周/月/季/年），下面是所选宽基的<strong>资金净流入</strong>（亿元，不是成交额）。
          柱子只有 2016 年之后——ETF 份额是近年才有的数据。底部滑块拖动看历史，滚轮缩放。
        </p>
      </div>

      <div class="fc__tabs" role="tablist">
        {baskets.map((b: any, i: number) => (
          <button class="fc__tab" type="button" data-idx={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            {b.name}
          </button>
        ))}
      </div>

      <div class="fc__periods" role="group" aria-label="K线周期">
        {
          [
            ['d', '日K'],
            ['w', '周K'],
            ['m', '月K'],
            ['q', '季K'],
            ['y', '年K'],
          ].map(([k, lab], i) => (
            <button class="fc__period" type="button" data-period={k} aria-pressed={i === 0 ? 'true' : 'false'}>
              {lab}
            </button>
          ))
        }
        <span class="fc__divider" aria-hidden="true" />
        {[
          ['30', 'MA30', 'var(--ma30)'],
          ['60', 'MA60', 'var(--ma60)'],
          ['250', 'MA250', 'var(--ma250)'],
        ].map(([n, lab, color]) => (
          <button class="fc__period fc__ma" type="button" data-ma={n} aria-pressed="true" style={`--ma:${color}`}>
            {lab}
          </button>
        ))}
      </div>

      <div class="fc__legend" data-legend />

      <div class="fc__canvas" data-canvas />

      {/* 手机上把当天信息显示在图外，避免遮挡 K 线 */}
      <div class="fc__info" data-info></div>

      <p class="fc__note" data-note />
    </section>
  )
}

<script>
  import * as echarts from 'echarts/core';
  import { CandlestickChart, BarChart, LineChart } from 'echarts/charts';
  import {
    GridComponent,
    TooltipComponent,
    DataZoomComponent,
    AxisPointerComponent,
  } from 'echarts/components';
  import { CanvasRenderer } from 'echarts/renderers';

  echarts.use([
    CandlestickChart,
    BarChart,
    LineChart, // 均线要用，漏了它 line series 会被静默忽略
    GridComponent,
    TooltipComponent,
    DataZoomComponent,
    AxisPointerComponent,
    CanvasRenderer,
  ]);

  const root = document.querySelector('[data-flowchart]') as HTMLElement | null;

  if (root) boot();

  /** 数据是独立 JSON，异步加载——11 年 K 线内嵌进 HTML 会把首屏拖慢 */
  async function boot() {
    let data: any = null;
    try {
      const res = await fetch('/data/etf-share/history.json');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      data = await res.json();
    } catch (e) {
      console.warn('history.json 加载失败', e);
      return;
    }
    const dates: string[] = data.dates || []; // 上证指数全历史
    const kline: any[] = data.kline || []; // [开,收,高,低]，和 dates 对齐
    const flowStart: number = Number(data.flowStart) || 0;
    const baskets: any[] = data.baskets || [];
    const aggregate: number[] = data.aggregate || [];
    const n = dates.length;

    const canvas = root.querySelector('[data-canvas]') as HTMLElement;
    const legend = root.querySelector('[data-legend]') as HTMLElement;
    const note = root.querySelector('[data-note]') as HTMLElement;
    const tabs = Array.from(root.querySelectorAll('[data-idx]')) as HTMLButtonElement[];

    const css = (k: string, fb: string) => getComputedStyle(document.documentElement).getPropertyValue(k).trim() || fb;

    /**
     * 把「只有 2016 年之后」的资金流铺到全历史时间轴上。
     *
     * ⚠️ 必须按日期对齐，不能按索引偏移：份额日期和 K 线日期之间有断档
     * （跨年第一天常见，比如 2017-12-29 直接跳到 2018-01-03），
     * 按索引铺每遇一个断档就整体错一天，累计能错七天，
     * 表现出来就是某天的资金流被安到了别的日期上。
     */
    const flowDates: string[] = data.flowDates || [];
    const dateIdx = new Map(dates.map((d, i) => [d, i]));

    /**
     * 份额数据覆盖到哪一天。
     * 只判断起点是不够的：K 线是当天的（今天有交易就有蜡烛），
     * 但份额要等交易所收盘后才公布，末尾这几天在 flow 里是 0。
     * 不区分「还没公布」和「没有变动」，就会把今天显示成「份额没有变动」。
     */
    const flowEnd = flowDates.length ? (dateIdx.get(flowDates[flowDates.length - 1]) ?? n - 1) : -1;

    function expand(short: number[]): number[] {
      const full = new Array(n).fill(0);
      for (let i = 0; i < flowDates.length; i++) {
        const j = dateIdx.get(flowDates[i]);
        if (j !== undefined && short[i] !== undefined) full[j] = short[i];
      }
      return full;
    }

    const fulls = baskets.map((b) => expand(b.flow || []));
    const aggFull = expand(aggregate);

    const sig = (v: number) => (v >= 0 ? '+' : '') + v.toFixed(2);
    let chart: any = null;
    let current = 0;
    let period = 'd'; // d 日 / w 周 / m 月 / q 季 / y 年
    let lastPeriod = '';
    let zoom = { start: 92, end: 100 };

    /** 周期分组键：同一周期的交易日归到一组 */
    function periodKey(d: string, p: string) {
      if (p === 'd') return d;
      const dt = new Date(d + 'T00:00:00Z');
      const y = dt.getUTCFullYear();
      const m = dt.getUTCMonth();
      if (p === 'w') {
        // 用周四当周标识，跨年也稳定
        const wd = dt.getUTCDay() || 7;
        return new Date(dt.getTime() + (4 - wd) * 86400000).toISOString().slice(0, 10);
      }
      if (p === 'm') return `${y}-${String(m + 1).padStart(2, '0')}`;
      if (p === 'q') return `${y}-Q${Math.floor(m / 3) + 1}`;
      return String(y);
    }

    /**
     * 把日线聚合成周/月/季/年线，资金流同期累加。
     * 开＝该周期第一天的开盘，收＝最后一天收盘，高低取区间极值。
     * 标签统一用该周期最后一个交易日，和看盘软件一致。
     */
    function group(flow: number[]) {
      const bars: any[] = [];
      let cur: any = null;
      let lastKey = '';
      for (let i = 0; i < n; i++) {
        const key = periodKey(dates[i], period);
        if (key !== lastKey) {
          if (cur) bars.push(cur);
          cur = { label: dates[i], o: null, c: null, h: null, l: null, flow: 0, hasFlow: false };
          lastKey = key;
        }
        const v = kline[i];
        if (v) {
          if (cur.o == null) cur.o = v[0];
          cur.c = v[1];
          cur.h = cur.h == null ? v[2] : Math.max(cur.h, v[2]);
          cur.l = cur.l == null ? v[3] : Math.min(cur.l, v[3]);
        }
        cur.flow += flow[i] || 0;
        if (i >= flowStart) cur.hasFlow = true;
        cur.label = dates[i];
      }
      if (cur) bars.push(cur);
      return bars;
    }

    /**
     * 均线颜色：30 红、60 绿、250 黑。
     * 颜色走 CSS 变量，深浅主题各一套——纯黑在深色背景上是看不见的，
     * 暗色下会自动换成浅灰。
     */
    const MA_FALLBACK: Record<number, string> = { 30: '#d92d20', 60: '#128a4e', 250: '#1f2937' };
    const maColor = (n: number) => css(`--ma${n}`, MA_FALLBACK[n]);
    const maOn: Record<number, boolean> = { 30: true, 60: true, 250: true };

    /**
     * 简单移动平均。均线跟着当前周期走——日K 是 30/60/250 日，
     * 切到周K 就是 30/60/250 周，和看盘软件一致。
     * 数据不足 n 根时给 null，图上就是断的，不会画出假的线头。
     */
    function movingAvg(bars: any[], n: number) {
      const out: (number | null)[] = [];
      const win: number[] = [];
      let sum = 0;
      for (const b of bars) {
        if (b.c == null) {
          out.push(null);
          win.length = 0;
          sum = 0;
          continue;
        }
        win.push(b.c);
        sum += b.c;
        if (win.length > n) sum -= win.shift() as number;
        out.push(win.length === n ? +(sum / n).toFixed(2) : null);
      }
      return out;
    }

    function render(idxNo: number) {
      current = idxNo;
      const up = css('--up', '#d92d20');
      const down = css('--down', '#128a4e');
      const muted = css('--muted', '#6b7688');
      const line = css('--hairline', 'rgba(0,0,0,.08)');
      const text = css('--text-dim', '#4a5568');

      const basket = baskets[idxNo];
      const flow = fulls[idxNo] ?? aggFull;
      const label = basket ? `${basket.name} 篮子` : '六大宽基合计';
      // 每个篮子各自的起点：新加的篮子只回溯了两年，不能按全局起点提示
      const bStart = basket?.start || dates[flowStart] || dates[0];

      const bars = group(flow);
      const labels = bars.map((b) => b.label);
      // candlestick 要 [开, 收, 低, 高]，日线存的是 [开, 收, 高, 低]
      const ohlc = bars.map((b) => (b.o == null ? '-' : [b.o, b.c, b.l, b.h]));

      // 均线只算一遍，tooltip 直接复用，别在 formatter 里重算
      const maData: Record<number, (number | null)[]> = {};
      for (const n of [30, 60, 250]) maData[n] = movingAvg(bars, n);

      const maSeries = [30, 60, 250]
        .filter((n) => maOn[n])
        .map((n) => ({
          name: `MA${n}`,
          type: 'line',
          data: maData[n],
          showSymbol: false,
          smooth: false,
          connectNulls: false,
          lineStyle: { width: 1.2, color: maColor(n) },
          itemStyle: { color: maColor(n) },
          z: 3,
        }));

      // 切换周期时重置可视范围：桌面看最近 140 根，手机看 70 根
      // （手机屏幕窄，140 根挤进去每根不到 2px，K 线糊成一片）
      if (lastPeriod !== period) {
        lastPeriod = period;
        const want = window.innerWidth <= 760 ? 70 : 140;
        const span = Math.min(want, bars.length);
        zoom = { start: Math.max(0, 100 - (span / Math.max(bars.length, 1)) * 100), end: 100 };
      }

      if (!chart) chart = echarts.init(canvas, null, { renderer: 'canvas' });

      /**
       * 把某一天的信息拼成 HTML。
       * 桌面端给 tooltip 用，手机端给图外那个信息条用——同一份逻辑，两处展示。
       */
      const infoHTML = (i: number): string => {
        const b = bars[i];
        if (!b) return '';

        const parts: string[] = [`<b>${b.label}</b>`];

        // 收盘价 + 涨跌幅
        if (b.c != null) {
          const prevC = i > 0 ? bars[i - 1].c : null;
          const chg = prevC ? ((b.c - prevC) / prevC) * 100 : null;
          const color = chg == null || chg === 0 ? '' : chg > 0 ? up : down;
          parts.push(`收 <b${color ? ` style="color:${color}"` : ''}>${b.c.toFixed(2)}</b>`);
          if (chg != null) {
            parts.push(`<span style="color:${color || muted}">${chg > 0 ? '+' : ''}${chg.toFixed(2)}%</span>`);
          }
        }

        // 篮子净流入 / 特殊情况说明
        const f = b.flow;
        if (i > flowEnd) {
          parts.push('<span style="opacity:.6">份额还没公布</span>');
        } else if (b.label < bStart) {
          parts.push(`<span style="opacity:.6">份额记录从 ${bStart} 起</span>`);
        } else if (f === 0) {
          parts.push('<span style="opacity:.6">份额无变动</span>');
        } else {
          parts.push(`${label} <b style="color:${f >= 0 ? up : down}">${sig(f)} 亿</b>`);
        }

        // 全部挤成一行，用全角空格分隔
        return parts.join('　');
      };

      chart.setOption(
        {
          animation: false,
          backgroundColor: 'transparent',
          axisPointer: { link: [{ xAxisIndex: 'all' }] },
          tooltip: {
            /*
             * 手机上不能直接 show:false —— 那样 axisPointer 的竖线光标也跟着没了。
             * 改成「链路保留、浮框隐形」：浮框内容照常生成但用 visibility 藏起来，
             * 竖线正常跟随手指，读数由图表下方那条信息显示。
             */
            show: true,
            trigger: 'axis',
            /*
             * confine：把提示框限制在图表区域内。
             * 不设这个，手指点在靠左的日子时，提示框会往左超出屏幕，
             * 手机竖屏上就是一截内容看不见。
             * max-width 兜住长文案，让它换行而不是横向撑出屏幕。
             */
            confine: true,
            extraCssText:
              window.innerWidth > 760
                ? 'max-width: 76vw; white-space: normal; line-height: 1.72; box-shadow: 0 6px 20px rgba(0,0,0,.14);'
                : 'visibility: hidden; padding: 0; border: 0;',
            /*
             * 手机上固定贴在图表顶部居中。
             * 默认跟着手指走，K 线密的时候框正好把手正在看的那段盖住；
             * 固定到顶部后，价格主体大部分露出来。
             */
            position: (point: any, params: any, dom: any, rect: any, size: any) => {
              // 桌面端跟着鼠标走，稍微偏移一点不挡光标
              if (window.innerWidth > 760) return [point[0] + 14, point[1] + 14];
              const vw = size.viewSize[0];
              const cw = size.contentSize[0];
              return [Math.max(6, (vw - cw) / 2), 6];
            },
            axisPointer: {
              // 手机上只要一条竖线，跟着点的地方走；桌面保留十字线
              type: window.innerWidth > 760 ? 'cross' : 'line',
              crossStyle: { color: muted },
              lineStyle: { color: muted, width: 1, type: 'solid' },
              label: { show: window.innerWidth > 760 },
            },
            backgroundColor: css('--surface', '#fff'),
            borderColor: line,
            textStyle: { color: text, fontSize: 12 },
            formatter: (ps: any[]) => {
              const i = ps[0]?.dataIndex ?? 0;
              const b = bars[i];
              if (!b) return '';
              const f = b.flow;
              let s = `<b>${b.label}</b>`;
              if (b.o != null) {
                const rising = b.c >= b.o;
                s +=
                  `<br/>开 ${b.o.toFixed(2)}　收 <b style="color:${rising ? up : down}">${b.c.toFixed(2)}</b>` +
                  `<br/>高 ${b.h.toFixed(2)}　低 ${b.l.toFixed(2)}`;
              }
              if (i > flowEnd) {
                s += `<br/><span style="opacity:.6">这天的份额还没公布，收盘后当晚更新</span>`;
              } else if (b.label < bStart) {
                s += `<br/><span style="opacity:.6">这个篮子的份额记录从 ${bStart} 起</span>`;
              } else if (f === 0) {
                s += '<br/><span style="opacity:.6">这天份额没有变动</span>';
              } else {
                s += `<br/>${label} <b style="color:${f >= 0 ? up : down}">${sig(f)} 亿</b>`;
              }
              const maLine = [30, 60, 250]
                .filter((n) => maOn[n] && maData[n][i] != null)
                .map((n) => `<span style="color:${maColor(n)}">MA${n} ${maData[n][i]}</span>`)
                .join('　');
              if (maLine) s += `<br/>${maLine}`;
              return s;
            },
          },
          /*
           * 用百分比而不是像素。
           *
           * 之前写的是 { top: 256, height: 88 } 这种绝对值，是按 384px 高的画布算的。
           * 手机上画布只有 320px，第二个图（资金流）下沿直接跑到容器外面被裁掉——
           * 表现为"下面那部分显示不全"。
           * 改成百分比后，不管画布多高都会按比例铺满。
           */
          grid: [
            { left: 46, right: 12, top: 12, height: '50%' },
            { left: 46, right: 12, top: '68%', height: '22%' },
          ],
          xAxis: [
            {
              type: 'category',
              data: labels,
              gridIndex: 0,
              boundaryGap: true,
              axisLine: { lineStyle: { color: line } },
              axisLabel: { show: false },
              axisTick: { show: false },
            },
            {
              type: 'category',
              data: labels,
              gridIndex: 1,
              boundaryGap: true,
              axisLine: { lineStyle: { color: line } },
              axisTick: { show: false },
              axisLabel: {
                color: muted,
                fontSize: 10,
                hideOverlap: true,
                /*
                 * 窄屏只靠 hideOverlap 会自动丢掉大部分标签，年份首先被丢，
                 * 导致手机上完全看不出横轴跨了哪几年。
                 *
                 * 这里改成「跨年显示年份、每季度显示月份」，用 interval 主动控制
                 * 哪些点出标签，不再依赖容器宽度去猜。
                 */
                interval: (index: number, value: string) => {
                  const prev = index > 0 ? labels[index - 1] : '';
                  if (!prev) return true;
                  if (prev.slice(0, 4) !== value.slice(0, 4)) return true;
                  const m = Number(value.slice(5, 7));
                  return m !== Number(prev.slice(5, 7)) && [1, 4, 7, 10].includes(m);
                },
                formatter: (value: string, index: number) => {
                  const prev = index > 0 ? labels[index - 1] : '';
                  if (!prev || prev.slice(0, 4) !== value.slice(0, 4)) return value.slice(0, 4);
                  return `${Number(value.slice(5, 7))}月`;
                },
              },
            },
          ],
          yAxis: [
            {
              scale: true,
              gridIndex: 0,
              splitLine: { lineStyle: { color: line } },
              axisLabel: { color: muted, fontSize: 11 },
              axisLine: { show: false },
              axisTick: { show: false },
            },
            {
              gridIndex: 1,
              splitLine: { show: false },
              axisLabel: { show: false },
              axisLine: { show: false },
              axisTick: { show: false },
            },
          ],
          dataZoom: [
            { type: 'inside', xAxisIndex: [0, 1], start: zoom.start, end: zoom.end, minValueSpan: 8 },
            {
              type: 'slider',
              xAxisIndex: [0, 1],
              start: zoom.start,
              end: zoom.end,
              bottom: 6,
              height: 20,
              borderColor: line,
              fillerColor: css('--accent-tint', 'rgba(150,102,10,.12)'),
              handleStyle: { color: css('--accent', '#96660a') },
              moveHandleStyle: { color: css('--accent', '#96660a') },
              dataBackground: {
                lineStyle: { color: muted, opacity: 0.5 },
                areaStyle: { color: muted, opacity: 0.12 },
              },
              textStyle: { color: muted, fontSize: 10 },
            },
          ],
          series: [
            {
              name: '上证指数',
              type: 'candlestick',
              data: ohlc,
              itemStyle: { color: up, color0: down, borderColor: up, borderColor0: down },
            },
            {
              name: '净流入',
              type: 'bar',
              xAxisIndex: 1,
              yAxisIndex: 1,
              data: bars.map((b) => ({
                value: b.flow,
                itemStyle: { color: b.flow >= 0 ? up : down, opacity: 0.8 },
              })),
            },
            ...maSeries,
          ],
        },
        true
      );

      chart.off('dataZoom');
      chart.on('dataZoom', () => {
        const z = chart.getOption().dataZoom?.[0];
        if (z) zoom = { start: z.start, end: z.end };
        updateLegend();
      });

      /*
       * 手机端的图外信息条。
       * 浮层怎么摆都会压住 K 线，干脆拿到图表外面来显示——
       * 点一下（或拖动十字线）就把当天数据写到下面这行，图本身始终完整可见。
       */
      const infoEl = root.querySelector('[data-info]') as HTMLElement | null;
      if (infoEl) {
        if (!infoEl.dataset.ready) {
          infoEl.dataset.ready = '1';
          infoEl.classList.add('fc__info--idle');
          infoEl.textContent = '点一下图表，这里显示当天数据';
        }

        const showAt = (i: number) => {
          if (i < 0 || i >= bars.length) return;
          infoEl.classList.remove('fc__info--idle');
          infoEl.innerHTML = infoHTML(i);
        };

        // 桌面：鼠标移动就更新（axisPointer 事件）
        chart.off('updateAxisPointer');
        chart.on('updateAxisPointer', (ev: any) => {
          const ax = ev.axesInfo && ev.axesInfo[0];
          if (!ax || ax.value == null) return;
          showAt(labels.indexOf(String(ax.value)));
        });

        /*
         * 手机：直接听画布点击。
         * 把 tooltip 关掉之后，axisPointer 就不再随手指触发了，
         * 所以这里自己算——按点击的横坐标反推是第几根，再写信息条。
         */
        const zr = chart.getZr();
        zr.off('click');
        zr.on('click', (ev: any) => {
          if (window.innerWidth > 760) return; // 桌面走鼠标悬浮，不重复处理
          const x = ev.offsetX;
          const y = ev.offsetY;
          const inMain = chart.containPixel({ gridIndex: 0 }, [x, y]);
          const inFlow = chart.containPixel({ gridIndex: 1 }, [x, y]);
          if (!inMain && !inFlow) return;
          const at = Math.round(chart.convertFromPixel({ xAxisIndex: 0 }, x) as number);
          showAt(at);
        });
      }

      tabs.forEach((t, i) => t.setAttribute('aria-pressed', String(i === idxNo)));
      note.textContent = `柱子 = ${label} 每日净流入合计，份额记录从 ${dates[flowStart] || '2016 年'} 开始`;
      updateLegend();

      function updateLegend() {
        const z = chart.getOption().dataZoom?.[0];
        const s = Math.round(z?.start ?? 0);
        const e = Math.round(z?.end ?? 100);
        const i0 = Math.floor((s / 100) * (bars.length - 1));
        const i1 = Math.max(i0, Math.ceil((e / 100) * (bars.length - 1)));
        const slice = bars.slice(i0, i1 + 1);
        const total = slice.reduce((a, b) => a + b.flow, 0);
        const hasFlow = slice.some((b) => b.label >= bStart);
        const lastBar = bars[bars.length - 1];
        const last = lastBar?.flow ?? 0;
        const unit = period === 'd' ? '当天' : '本期';

        // 最后一根比份额数据还新，说明份额还没公布，别拿 0 充当「没变动」
        const lastFlowDate = flowDates[flowDates.length - 1] || '';
        if (lastBar && lastFlowDate && lastBar.label > lastFlowDate) {
          legend.innerHTML =
            `<span class="dim">${lastBar.label} 的份额还没公布，收盘后当晚更新</span>` +
            `<span>可见区间累计 <strong class="${total >= 0 ? 'up' : 'down'}">${sig(total).replace(
              /\.\d+$/,
              ''
            )} 亿</strong></span>` +
            `<span class="dim">${bars[i0]?.label} ~ ${bars[i1]?.label}（${bars.length} 根）</span>`;
          return;
        }

        legend.innerHTML = hasFlow
          ? `<span>${unit}（${lastBar?.label ?? ''}） <strong class="${last >= 0 ? 'up' : 'down'}">${sig(
              last
            )} 亿</strong></span>` +
            `<span>可见区间累计 <strong class="${total >= 0 ? 'up' : 'down'}">${sig(total).replace(
              /\.\d+$/,
              ''
            )} 亿</strong></span>` +
            `<span class="dim">${bars[i0]?.label} ~ ${bars[i1]?.label}（${bars.length} 根）</span>`
          : `<span class="dim">这一段只有 K 线，这个篮子的份额记录从 ${bStart} 起</span>` +
            `<span class="dim">${bars[i0]?.label} ~ ${bars[i1]?.label}</span>`;
      }
    }

    tabs.forEach((t) => t.addEventListener('click', () => render(Number(t.dataset.idx))));

    // 周期切换：只在前端聚合，不用重新取数
    const pbtns = Array.from(root.querySelectorAll('[data-period]')) as HTMLButtonElement[];
    pbtns.forEach((b) => {
      b.addEventListener('click', () => {
        period = b.dataset.period || 'd';
        pbtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        render(current);
      });
    });

    // 均线开关
    const mbtns = Array.from(root.querySelectorAll('[data-ma]')) as HTMLButtonElement[];
    mbtns.forEach((b) => {
      b.addEventListener('click', () => {
        const n = Number(b.dataset.ma);
        maOn[n] = !maOn[n];
        b.setAttribute('aria-pressed', String(maOn[n]));
        render(current);
      });
    });

    render(0);

    window.addEventListener('resize', () => chart?.resize());
    new MutationObserver(() => render(current)).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'class'],
    });
  }
</script>

<style>
  .fc {
    margin-bottom: 28px;
  }

  .fc__head {
    margin-bottom: 12px;
  }

  .fc__h {
    margin: 0 0 4px;
    font-size: 17px;
  }

  .fc__sub {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.65;
  }

  .fc__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .fc__tab {
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--chip-fill);
    color: var(--text-dim);
    font-size: 13px;
    font-family: var(--font);
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .fc__tab:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .fc__tab[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .fc__periods {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin-bottom: 10px;
  }

  .fc__divider {
    width: 1px;
    height: 16px;
    margin: 0 4px;
    background: var(--border);
  }

  .fc__period {
    min-width: 46px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    font-family: var(--font);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .fc__period:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .fc__period[aria-pressed='true'] {
    background: var(--accent-tint);
    border-color: var(--accent-border);
    color: var(--accent);
    font-weight: 600;
  }

  /* 均线开关：用各自的颜色，关掉时只留灰点 */
  .fc__ma::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 4px;
    border-radius: 50%;
    background: var(--ma);
    opacity: 0.35;
    vertical-align: 1px;
  }

  .fc__ma[aria-pressed='true'] {
    background: transparent;
    border-color: var(--ma);
    color: var(--ma);
    font-weight: 600;
  }

  .fc__ma[aria-pressed='true']::before {
    opacity: 1;
  }

  .fc__ma[aria-pressed='false'] {
    background: transparent;
    border-color: var(--border);
    color: var(--muted);
  }

  .fc__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--text-dim);
  }

  .fc__legend .dim {
    color: var(--muted);
  }

  .fc__canvas {
    width: 100%;
    height: 384px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  /* 手机端的图外信息条：桌面端用 tooltip，这里不占地方 */
  .fc__info {
    display: none;
    margin-top: 8px;
    padding: 8px 11px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    font-size: 12px;
    line-height: 1.6;
    color: var(--text);
    min-height: 34px;
  }

  .fc__info--idle {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .fc__info {
      display: block;
    }
  }

  .fc__note {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .fc__canvas {
      height: 320px;
    }
  }

  /* 手机横屏：可视高度只剩三百多，图必须按视口算，否则被截掉一半。
     放在竖屏规则后面，避免小屏横屏时被 320px 覆盖掉 */
  @media (orientation: landscape) and (max-height: 560px) {
    .fc__canvas {
      height: 62vh;
      min-height: 190px;
    }

    .fc__legend {
      gap: 8px;
      font-size: 11px;
      margin-top: 6px;
    }

    .fc__note {
      font-size: 11px;
      margin-top: 6px;
    }
  }

  /* 手机竖屏：周期和均线按钮一共 8 个，不缩小会挤成三行 */
  @media (max-width: 560px) {
    .fc__canvas {
      height: 280px;
    }

    .fc__periods {
      gap: 3px;
    }

    .fc__period {
      min-width: 0;
      padding: 4px 7px;
      font-size: 11px;
    }

    .fc__divider {
      margin: 0 2px;
    }

    .fc__legend {
      gap: 10px;
      font-size: 12px;
    }

    .fc__sub {
      font-size: 12px;
    }
  }
</style>

<style is:global>
  /* 均线配色：30 红 / 60 绿 / 250 黑。深色主题下 250 换成浅灰，否则黑线贴在黑底上看不见 */
  :root {
    --ma30: #d92d20;
    --ma60: #128a4e;
    --ma250: #1f2937;
  }

  html[data-theme='dark'] {
    --ma30: #ff4d4f;
    --ma60: #17c964;
    --ma250: #d1d5db;
  }

  /* 图例由 JS 生成，拿不到作用域标记 */
  .fc__legend .up {
    color: var(--up);
  }

  .fc__legend .down {
    color: var(--down);
  }
</style>
