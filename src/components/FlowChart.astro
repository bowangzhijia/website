---
/**
 * 指数 K 线 + 宽基资金流柱状图（可缩放、可拖动，像看盘软件那样）。
 *
 * 用 ECharts 的 dataZoom：底部进度条拖动、滚轮缩放、按住左右平移。
 * 手写 SVG 做不出这个交互，所以这里引了图表库，按需引入控制体积。
 *
 * 数据来自 src/data/etf-share/history.json，脚本每天生成。
 */
interface Props {
  data: any;
}

const { data } = Astro.props;
const indices = (data?.indices ?? []).filter((x: any) => Array.isArray(x.k) && x.k.length);
---

{
  indices.length > 0 && (
    <section class="fc" data-flowchart>
      <div class="fc__head">
        <h2 class="fc__h">指数走势 vs 资金流</h2>
        <p class="fc__sub">
          上面 K 线，下面是<strong>资金净流入</strong>（亿元，不是成交额）。
          底部滑块拖动看历史，滚轮缩放，按住图表可以左右平移。
        </p>
      </div>

      <div class="fc__tabs" role="tablist">
        {indices.map((it: any, i: number) => (
          <button class="fc__tab" type="button" data-idx={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            {it.name}
          </button>
        ))}
      </div>

      <div class="fc__legend" data-legend />

      <div class="fc__canvas" data-canvas />

      <p class="fc__note" data-note />
    </section>
  )
}

<script type="application/json" id="flow-data" is:inline set:html={JSON.stringify({
    dates: data?.dates ?? [],
    baskets: data?.baskets ?? [],
    aggregate: data?.aggregate ?? [],
    indices,
  })}></script>

<script>
  import * as echarts from 'echarts/core';
  import { CandlestickChart, BarChart } from 'echarts/charts';
  import {
    GridComponent,
    TooltipComponent,
    DataZoomComponent,
    AxisPointerComponent,
  } from 'echarts/components';
  import { CanvasRenderer } from 'echarts/renderers';

  echarts.use([
    CandlestickChart,
    BarChart,
    GridComponent,
    TooltipComponent,
    DataZoomComponent,
    AxisPointerComponent,
    CanvasRenderer,
  ]);

  const el = document.getElementById('flow-data');
  const root = document.querySelector('[data-flowchart]') as HTMLElement | null;

  if (el && root) {
    const data = JSON.parse(el.textContent || '{}');
    const dates: string[] = data.dates || [];
    const baskets: any[] = data.baskets || [];
    const aggregate: number[] = data.aggregate || [];
    const indices: any[] = data.indices || [];

    const canvas = root.querySelector('[data-canvas]') as HTMLElement;
    const legend = root.querySelector('[data-legend]') as HTMLElement;
    const note = root.querySelector('[data-note]') as HTMLElement;
    const tabs = Array.from(root.querySelectorAll('[data-idx]')) as HTMLButtonElement[];

    const css = (k: string, fb: string) => getComputedStyle(document.documentElement).getPropertyValue(k).trim() || fb;

    let chart: any = null;
    let current = 0;
    let zoom = { start: 40, end: 100 };

    function seriesOf(it: any) {
      const basket = baskets.find((b) => b.id === it.basket);
      // 上证综指没有规模够看的 ETF，退化成六大宽基合计
      const flow: number[] = basket?.flow ?? aggregate;
      const label = basket ? `${it.name} 篮子` : '六大宽基合计';
      return { flow, label };
    }

    function render(idxNo: number) {
      const it = indices[idxNo];
      if (!it) return;
      current = idxNo;

      const up = css('--up', '#d92d20');
      const down = css('--down', '#128a4e');
      const muted = css('--muted', '#6b7688');
      const line = css('--hairline', 'rgba(0,0,0,.08)');
      const text = css('--text-dim', '#4a5568');

      const { flow, label } = seriesOf(it);

      // candlestick 要 [开, 收, 低, 高]，我们存的是 [开, 收, 高, 低]
      const ohlc = it.k.map((v: any) => (v ? [v[0], v[1], v[3], v[2]] : '-'));

      if (!chart) chart = echarts.init(canvas, null, { renderer: 'canvas' });

      const option = {
        animation: false,
        backgroundColor: 'transparent',
        axisPointer: { link: [{ xAxisIndex: 'all' }], label: { backgroundColor: muted } },
        tooltip: {
          trigger: 'axis',
          axisPointer: { type: 'cross', crossStyle: { color: muted } },
          backgroundColor: css('--surface', '#fff'),
          borderColor: line,
          textStyle: { color: text, fontSize: 12 },
          formatter: (ps: any[]) => {
            const i = ps[0]?.dataIndex ?? 0;
            const v = it.k[i];
            const f = flow[i] ?? 0;
            const sg = (n: number) => (n >= 0 ? '+' : '') + n.toFixed(2);
            let s = `<b>${dates[i]}</b>`;
            if (v) {
              const rising = v[1] >= v[0];
              s +=
                `<br/>开 ${v[0].toFixed(2)}　收 <b style="color:${rising ? up : down}">${v[1].toFixed(2)}</b>` +
                `<br/>高 ${v[2].toFixed(2)}　低 ${v[3].toFixed(2)}`;
            }
            s +=
              `<br/>${label} <b style="color:${f >= 0 ? up : down}">${sg(f)} 亿</b>`;
            return s;
          },
        },
        grid: [
          { left: 56, right: 18, top: 16, height: 210 },
          { left: 56, right: 18, top: 258, height: 92 },
        ],
        xAxis: [
          {
            type: 'category',
            data: dates,
            gridIndex: 0,
            boundaryGap: true,
            axisLine: { lineStyle: { color: line } },
            axisLabel: { show: false },
            axisTick: { show: false },
          },
          {
            type: 'category',
            data: dates,
            gridIndex: 1,
            boundaryGap: true,
            axisLine: { lineStyle: { color: line } },
            axisTick: { show: false },
            axisLabel: { color: muted, fontSize: 10, hideOverlap: true },
          },
        ],
        yAxis: [
          {
            scale: true,
            gridIndex: 0,
            splitLine: { lineStyle: { color: line } },
            axisLabel: { color: muted, fontSize: 11 },
            axisLine: { show: false },
            axisTick: { show: false },
          },
          {
            gridIndex: 1,
            splitLine: { show: false },
            axisLabel: { show: false },
            axisLine: { show: false },
            axisTick: { show: false },
          },
        ],
        dataZoom: [
          { type: 'inside', xAxisIndex: [0, 1], start: zoom.start, end: zoom.end, minValueSpan: 8 },
          {
            type: 'slider',
            xAxisIndex: [0, 1],
            start: zoom.start,
            end: zoom.end,
            bottom: 6,
            height: 20,
            borderColor: line,
            fillerColor: css('--accent-tint', 'rgba(150,102,10,.12)'),
            handleStyle: { color: css('--accent', '#96660a') },
            moveHandleStyle: { color: css('--accent', '#96660a') },
            dataBackground: {
              lineStyle: { color: muted, opacity: 0.5 },
              areaStyle: { color: muted, opacity: 0.12 },
            },
            textStyle: { color: muted, fontSize: 10 },
          },
        ],
        series: [
          {
            name: 'K线',
            type: 'candlestick',
            data: ohlc,
            itemStyle: { color: up, color0: down, borderColor: up, borderColor0: down },
          },
          {
            name: '净流入',
            type: 'bar',
            xAxisIndex: 1,
            yAxisIndex: 1,
            data: flow.map((v: number) => ({
              value: v,
              itemStyle: { color: v >= 0 ? up : down, opacity: 0.8 },
            })),
          },
        ],
      };

      chart.setOption(option, true);
      chart.off('dataZoom');
      chart.on('dataZoom', () => {
        const m = chart.getOption().dataZoom?.[0];
        if (m) zoom = { start: m.start, end: m.end };
        updateLegend();
      });

      updateLegend();
      tabs.forEach((t, i) => t.setAttribute('aria-pressed', String(i === idxNo)));

      const n = dates.length;
      note.textContent = basket
        ? `柱子 = ${it.name} 下所有 ETF 的净流入合计`
        : `上证综指没有规模够看的 ETF，柱子显示六大宽基合计`;

      function updateLegend() {
        const opt = chart.getOption().dataZoom?.[0];
        const s = Math.round(opt?.start ?? 0);
        const e = Math.round(opt?.end ?? 100);
        const i0 = Math.floor((s / 100) * (n - 1));
        const i1 = Math.max(i0, Math.ceil((e / 100) * (n - 1)));
        const slice = flow.slice(i0, i1 + 1).filter((x: number) => x !== 0);
        const total = slice.reduce((a: number, b: number) => a + b, 0);
        const last = flow[n - 1] ?? 0;
        const sg = (v: number) => (v >= 0 ? '+' : '') + v.toFixed(2);

        legend.innerHTML =
          `<span>当天（${dates[n - 1]}） <strong class="${last >= 0 ? 'up' : 'down'}">${sg(last)} 亿</strong></span>` +
          `<span>可见区间累计 <strong class="${total >= 0 ? 'up' : 'down'}">${
            total >= 0 ? '+' : ''
          }${total.toFixed(0)} 亿</strong></span>` +
          `<span class="dim">${dates[i0]} ~ ${dates[i1]}</span>`;
      }
    }

    tabs.forEach((t) => t.addEventListener('click', () => render(Number(t.dataset.idx))));

    render(0);

    const onResize = () => chart?.resize();
    window.addEventListener('resize', onResize);

    // 主题切换后重画，否则颜色还是旧的
    new MutationObserver(() => render(current)).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'class'],
    });
  }
</script>

<style>
  .fc {
    margin-bottom: 28px;
  }

  .fc__head {
    margin-bottom: 12px;
  }

  .fc__h {
    margin: 0 0 4px;
    font-size: 17px;
  }

  .fc__sub {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.65;
  }

  .fc__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .fc__tab {
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--chip-fill);
    color: var(--text-dim);
    font-size: 13px;
    font-family: var(--font);
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .fc__tab:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .fc__tab[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .fc__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--text-dim);
  }

  .fc__legend .dim {
    color: var(--muted);
  }

  .fc__canvas {
    width: 100%;
    height: 386px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .fc__note {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .fc__canvas {
      height: 320px;
    }
  }
</style>

<style is:global>
  /* 图例由 JS 生成，拿不到作用域标记 */
  .fc__legend .up {
    color: var(--up);
  }

  .fc__legend .down {
    color: var(--down);
  }
</style>
