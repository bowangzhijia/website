---
import ShareTable from './ShareTable.astro';
import FlowChart from './FlowChart.astro';
import RunStatus from './RunStatus.astro';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

/**
 * embedded = true 表示内嵌在栏目页里，此时不重复渲染返回链接和大标题
 * （栏目页本身已经有 h1 了），只有独立页 /etf-share/ 才显示完整头部。
 */
interface Props {
  embedded?: boolean;
}
const { embedded = false } = Astro.props;

/**
 * ETF 份额看板。
 *
 * 数据全部来自构建时读的 latest.json（由 scripts/etf-share.mjs 每天生成），
 * 页面本身不发请求，纯静态。
 *
 * 注意：这里用 process.cwd()（项目根）而不是 import.meta.url——
 * Astro 构建时后者会被改写成别的路径，existsSync 直接 false，页面就空了。
 */

const dataPath = join(process.cwd(), 'src', 'data', 'etf-share', 'latest.json');
const histPath = join(process.cwd(), 'src', 'data', 'etf-share', 'history.json');

let data: any = null;
if (existsSync(dataPath)) {
  try {
    data = JSON.parse(readFileSync(dataPath, 'utf8'));
  } catch {
    data = null;
  }
}

let history: any = null;
if (existsSync(histPath)) {
  try {
    history = JSON.parse(readFileSync(histPath, 'utf8'));
  } catch {
    history = null;
  }
}

const rows: any[] = data?.rows ?? [];
const hasPrice = !!data?.hasPrice;

/**
 * 规模门槛（亿元），与 scripts/etf-share.mjs 的 MIN_SCALE 保持一致。
 * 每天按最新规模重算，所以涨过 10 亿自动进来、缩下去自动退出。
 */
const MIN_SCALE = 10;

/** 与脚本一致：反直觉榜要有绝对额门槛，否则全是小 ETF */
const bigEnough = (r: any) => (r.amt != null ? Math.abs(r.amt) >= 5 : Math.abs(r.d) >= 1);

// 榜单只看 10 亿以上的；搜索仍然查全量
const pool = rows.filter((r) => (r.sc ?? 0) >= MIN_SCALE);
const poolChanged = pool.filter((r) => r.d !== 0).length;
const changedCount = data?.changed ?? rows.filter((r) => r.d !== 0).length;

// 按金额排，不按份数：不同 ETF 单价差十倍，按份数排会偏袒低价品种
const byAmountDesc = (a: any, b: any) => (b.amt ?? -Infinity) - (a.amt ?? -Infinity);
const byAmountAsc = (a: any, b: any) => (a.amt ?? Infinity) - (b.amt ?? Infinity);

const inflow = pool.filter((r) => r.d > 0).sort(byAmountDesc).slice(0, 12);
const outflow = pool.filter((r) => r.d < 0).sort(byAmountAsc).slice(0, 12);
const upRedeem = pool
  .filter((r) => r.chg != null && r.chg > 0 && r.d < 0 && bigEnough(r))
  .sort((a, b) => (a.amt ?? a.d) - (b.amt ?? b.d))
  .slice(0, 10);
const downBuy = pool
  .filter((r) => r.chg != null && r.chg < 0 && r.d > 0 && bigEnough(r))
  .sort((a, b) => (b.amt ?? b.d) - (a.amt ?? a.d))
  .slice(0, 10);
const streak = pool
  .filter((r) => r.d > 0 && r.st >= 3)
  .sort((a, b) => b.st - a.st)
  .slice(0, 10);

/** 宽基篮子（按指数加总，配置见 src/data/etf-share/baskets.json） */
const baskets: any[] = data?.baskets ?? [];
const basketAmount = baskets.reduce((s: number, b: any) => s + (b.amt || 0), 0);

const [, mm, dd] = (data?.date || '---- -- --').split('-');
const dateLabel = mm ? `${Number(mm)}月${Number(dd)}日` : '';

const n2 = (v: number) => (v > 0 ? '+' : '') + v.toFixed(2);
---


  <section class="screen">
    <div class="wrap sc">
      <header class="sc__head">
        {!embedded && <a class="sc__back" href="/columns/etf-share/">← ETF份额</a>}
        {!embedded && <h1 class="sc__title">ETF 份额看板</h1>}
        <p class="sc__lead">
          {
            data
              ? `更新至 ${dateLabel} 收盘，对比上一交易日（${data.prevDate}）。份额是真金白银的申购赎回，规模涨可能只是净值涨。`
              : '数据正在准备，稍后就有'
          }
        </p>
        <p class="sc__meta">每个交易日 20:30 前后更新；当晚交易所尚未披露的，次日上午 9 点后补上</p>
      </header>

      {data && <RunStatus date={data.date} total={data.total} />}

      {data && (
        <>
          <div class="stats">
            <div class="stat">
              <span class="stat__k">净申购</span>
              <strong class="stat__v up">{data.inflowCount}</strong>
              <span class="stat__u">只</span>
            </div>
            <div class="stat">
              <span class="stat__k">净赎回</span>
              <strong class="stat__v down">{data.outflowCount}</strong>
              <span class="stat__u">只</span>
            </div>
            <div class="stat">
              <span class="stat__k">合计净流入</span>
              <strong class={`stat__v ${data.netAmount >= 0 ? 'up' : 'down'}`}>{n2(data.netAmount)}</strong>
              <span class="stat__u">亿元</span>
            </div>
            <div class="stat">
              <span class="stat__k">覆盖</span>
              <strong class="stat__v">{data.total}</strong>
              <span class="stat__u">只 ETF</span>
            </div>
          </div>

          {history && <FlowChart data={history} />}

          {baskets.length > 0 && (
            <section class="bk">
              <div class="bk__head">
                <h2 class="bk__h">指数篮子</h2>
                <p class="bk__sub">
                  一个指数挂十几只 ETF，是同一份敞口。汇金买哪只都一样，加总才看得出进了多少钱。
                  点开任意一个能看成分明细；最后一个「创新药」是主题篮子，港股占六成。
                </p>
              </div>
              <div class="bk__grid">
                {baskets.map((b: any) => (
                  <details class="bk__card">
                    <summary class="bk__sum">
                      <div class="bk__name">
                        {b.name}
                        <span class="bk__n">{b.n} 只</span>
                      </div>
                      <div class={`bk__v ${b.amt >= 0 ? 'up' : 'down'}`}>
                        {n2(b.amt)}
                        <span class="bk__u">亿</span>
                      </div>
                      <div class="bk__scale">
                        篮子规模 {Math.round(b.s)} 亿
                        <span class="bk__more">点开看成分</span>
                      </div>
                    </summary>
                    {/* 手机屏幕窄，四列放不下，套一层横向滚动而不是让它顶出卡片 */}
                    <div class="bk__tbwrap">
                      <table class="bk__tb">
                        <thead>
                          <tr>
                            <th>代码</th>
                            <th>名称</th>
                            <th class="r">
                              净流入<span class="u">(亿元)</span>
                            </th>
                            <th class="r">
                              规模<span class="u">(亿元)</span>
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          {(b.members || []).map((m: any) => (
                            <tr>
                              <td class="code">{m.c}</td>
                              <td class="nm">{m.n}</td>
                              <td class={`r amt ${m.amt > 0 ? 'up' : m.amt < 0 ? 'down' : 'dim'}`}>
                                {m.amt === 0 ? '—' : (m.amt > 0 ? '+' : '') + m.amt.toFixed(2)}
                              </td>
                              <td class="r dim">{m.s.toFixed(2)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </details>
                ))}
              </div>
              <p class="bk__foot">
                篮子合计 <strong class={basketAmount >= 0 ? 'up' : 'down'}>{n2(basketAmount)} 亿</strong>
                ，其余 {rows.length - baskets.reduce((s: number, b: any) => s + (b.n || 0), 0)} 行变动来自行业主题、跨境、债券和商品。
              </p>
            </section>
          )}

          <p class="scope">
            全市场 <strong>{rows.length}</strong> 只 ETF，当日有 <strong>{changedCount}</strong> 只出现份额变动。
            榜单只收录其中规模 ≥ {MIN_SCALE} 亿的（<strong>{pool.length}</strong> 只，{poolChanged} 只有变动）。
            门槛每天按最新规模重算，涨过线自动纳入、缩下去自动剔除，不用维护名单。
            份额是交易所收盘后披露的统计口径，不是盘中实时行情。
            想看某只具体的，往下拉搜索框，那里是全量。
          </p>

          {/* 搜索是全量 987 行，静态渲染太重，交给 JS 过滤 */}
          <div class="sr">
            <label class="sr__label" for="q">查单只</label>
            <input
              class="sr__input"
              id="q"
              type="search"
              placeholder="代码或名称，例如 510300 / 沪深300"
              autocomplete="off"
            />
            <div class="sr__hint" id="sr-hint"></div>
            <div class="sr__wrap" id="sr-wrap" hidden>
              <table class="sr__table">
                <thead>
                  <tr>
                    <th>代码</th>
                    <th>名称</th>
                    {hasPrice && <th class="r">净流入(亿元)</th>}
                    <th class="r">规模(亿)</th>
                    <th class="r">变化(亿份)</th>
                    <th class="r">变化率</th>
                    <th class="r">涨跌幅</th>
                  </tr>
                </thead>
                <tbody id="sr-body"></tbody>
              </table>
            </div>
          </div>

          {inflow.length > 0 && (
            <section class="blk">
              <h2 class="blk__h">净申购 TOP 12</h2>
              <ShareTable rows={inflow} hasPrice={hasPrice} showStreak />
            </section>
          )}

          {outflow.length > 0 && (
            <section class="blk">
              <h2 class="blk__h">净赎回 TOP 12</h2>
              <ShareTable rows={outflow} hasPrice={hasPrice} showStreak />
            </section>
          )}

          {upRedeem.length > 0 && (
            <section class="blk">
              <h2 class="blk__h">涨了，份额却在减</h2>
              <p class="blk__tip">价格涨、份额降，有资金借着上涨离场。只列 5 亿元以上的。</p>
              <ShareTable rows={upRedeem} hasPrice={hasPrice} />
            </section>
          )}

          {downBuy.length > 0 && (
            <section class="blk">
              <h2 class="blk__h">跌了，份额反而增</h2>
              <p class="blk__tip">价格跌、份额涨，是逆势抄底的动作。只列 5 亿元以上的。</p>
              <ShareTable rows={downBuy} hasPrice={hasPrice} showStreak />
            </section>
          )}

          {streak.length > 0 && (
            <section class="blk">
              <h2 class="blk__h">连续净申购 3 天以上</h2>
              <p class="blk__tip">连着几天都在被买，比单日的猛增更值得留意。</p>
              <ShareTable rows={streak} hasPrice={hasPrice} showStreak />
            </section>
          )}

          <p class="foot">
            数据来自上交所 / 深交所官方披露，金额按当日收盘价折算，是估算值。
            新上市 ETF 首日无份额，已跳过；份额拆分或大额申购会在文章里单独说明。
          </p>
        </>
      )}
    </div>
  </section>

  <script type="application/json" id="etf-data" is:inline set:html={JSON.stringify(rows)}></script>


<script>
  const el = document.getElementById('etf-data');
  const input = document.getElementById('q') as HTMLInputElement | null;
  const body = document.getElementById('sr-body');
  const wrap = document.getElementById('sr-wrap');
  const hint = document.getElementById('sr-hint');

  if (el && input && body && wrap && hint) {
    const rows: any[] = JSON.parse(el.textContent || '[]');
    const hasPrice = rows.some((r) => r.amt != null);

    const sign = (v: number | null, suffix = '') =>
      v == null ? '—' : (v > 0 ? '+' : '') + v.toFixed(2) + suffix;
    const tone = (v: number | null) => (v == null || v === 0 ? '' : v > 0 ? 'up' : 'down');

    const render = (list: any[]) => {
      body.innerHTML = '';
      for (const r of list) {
        const tr = document.createElement('tr');
        tr.innerHTML =
          `<td class="code">${r.c}</td><td>${r.n}</td>` +
          (hasPrice ? `<td class="r ${tone(r.amt)}">${sign(r.amt)}</td>` : '') +
          `<td class="r dim">${r.sc != null ? r.sc.toFixed(1) : '—'}</td>` +
          `<td class="r ${tone(r.d)}">${sign(r.d)}</td>` +
          `<td class="r ${tone(r.p)}">${sign(r.p, '%')}</td>` +
          `<td class="r ${tone(r.chg)}">${sign(r.chg, '%')}</td>`;
        body.appendChild(tr);
      }
    };

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        wrap.hidden = true;
        hint.textContent = '';
        return;
      }
      const hit = rows.filter((r) => r.c.includes(q) || r.n.toLowerCase().includes(q));
      wrap.hidden = hit.length === 0;
      hint.textContent = hit.length ? `匹配 ${hit.length} 只，显示前 30 只` : '没找到这只 ETF';
      render(hit.slice(0, 30));
    });
  }
</script>

<style>
  .sc {
    padding: 28px 0 calc(48px + var(--tabbar-h, 0px));
  }

  .sc__back {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }

  .sc__back:hover {
    color: var(--accent);
  }

  .sc__title {
    margin: 10px 0 8px;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .sc__lead {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  /* 更新时间说明：别让读者以为数据没在更新 */
  .sc__meta {
    margin: 6px 0 0;
    font-size: 12px;
    color: var(--text-dim);
    opacity: 0.75;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 22px 0 14px;
  }

  .stat {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card-bg);
  }

  .stat__k {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .stat__v {
    font-size: 22px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .stat__u {
    margin-left: 4px;
    font-size: 12px;
    color: var(--muted);
  }

  /* 红涨绿跌，跟国内看盘软件一致 */
  .up {
    color: var(--up);
  }

  .down {
    color: var(--down);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 26px;
  }

  .split__item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 14px;
    color: var(--muted);
  }

  /* 宽基篮子 */
  .bk {
    margin-bottom: 26px;
  }

  .bk__head {
    margin-bottom: 12px;
  }

  .bk__h {
    margin: 0 0 4px;
    font-size: 17px;
  }

  .bk__sub {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
  }

  .bk__grid {
    display: grid;
    /* 篮子从 6 个变 7 个，写死 3 列会让最后一行只剩一个，改成自适应 */
    grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
    gap: 10px;
  }

  .bk__card {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card-bg);
  }

  /* 展开后占满整行，成分表才放得下 */
  .bk__card[open] {
    grid-column: 1 / -1;
    border-color: var(--accent-border);
  }

  .bk__sum {
    cursor: pointer;
    list-style: none;
  }

  .bk__sum::-webkit-details-marker {
    display: none;
  }

  .bk__more {
    margin-left: 8px;
    color: var(--accent);
  }

  /* 成分表在手机上放不下，横向滚动；min-width 保证列不被挤成一条 */
  .bk__tbwrap {
    margin-top: 12px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .bk__tb {
    width: 100%;
    min-width: 420px;
    border-collapse: collapse;
    font-size: 13px;
  }

  .bk__tb th,
  .bk__tb td {
    padding: 7px 10px;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    white-space: nowrap;
  }

  .bk__tb th {
    background: var(--thead-fill);
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }

  .bk__tb tbody tr:last-child td {
    border-bottom: 0;
  }

  .bk__tb .r {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* 净流入是排序依据，加粗一点和规模区分开 */
  .bk__tb .amt {
    font-weight: 700;
  }

  .bk__tb .code {
    font-family: var(--font-mono);
    color: var(--text-dim);
  }

  .bk__tb .dim {
    color: var(--muted);
  }

  .bk__name {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .bk__n {
    font-size: 11px;
    font-weight: 400;
    color: var(--muted);
  }

  .bk__v {
    font-size: 24px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .bk__u {
    font-size: 13px;
    font-weight: 400;
    margin-left: 2px;
  }

  .bk__scale {
    margin-top: 6px;
    font-size: 12px;
    color: var(--muted);
  }

  .bk__foot {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.7;
  }

  .scope {
    margin: 0 0 16px;
    padding: 10px 14px;
    border-left: 2px solid var(--accent);
    background: var(--accent-tint);
    border-radius: 0 8px 8px 0;
    font-size: 13px;
    line-height: 1.75;
    color: var(--text-dim);
  }

  .sr {
    margin-bottom: 30px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card-bg);
  }

  .sr__label {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .sr__input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--input-border);
    border-radius: 10px;
    background: var(--input-bg);
    color: var(--text);
    font-size: 14px;
    font-family: var(--font);
  }

  .sr__input:focus {
    outline: none;
    border-color: var(--accent-border);
    box-shadow: 0 0 0 3px var(--accent-ring);
  }

  .sr__hint {
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
    min-height: 1em;
  }

  .blk {
    margin-bottom: 30px;
  }

  .blk__h {
    margin: 0 0 10px;
    font-size: 17px;
  }

  .blk__tip {
    margin: -4px 0 12px;
    font-size: 13px;
    color: var(--muted);
  }

  .foot {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
    font-size: 12px;
    color: var(--muted);
    line-height: 1.8;
  }

  @media (max-width: 760px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .bk__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .sc__title {
      font-size: 22px;
    }
  }

  /* 手机竖屏：卡片和数字都缩一档，否则四列统计挤成豆腐块 */
  @media (max-width: 560px) {
    .stat {
      padding: 11px 13px;
    }

    .stat__k {
      font-size: 11px;
    }

    .stat__v {
      font-size: 19px;
    }

    .bk__card {
      padding: 12px 13px;
    }

    .bk__name {
      font-size: 13px;
    }

    .bk__v {
      font-size: 20px;
    }

    /* 手机上不用横向滑动：固定表格布局 + 按比例分列，名称过长就省略 */
    .bk__tbwrap {
      overflow-x: visible;
    }

    .bk__tb {
      min-width: 0;
      table-layout: fixed;
      font-size: 11.5px;
    }

    .bk__tb th:nth-child(1),
    .bk__tb td:nth-child(1) {
      width: 21%;
    }

    .bk__tb th:nth-child(2),
    .bk__tb td:nth-child(2) {
      width: 37%;
    }

    .bk__tb th:nth-child(3),
    .bk__tb td:nth-child(3) {
      width: 23%;
    }

    .bk__tb th:nth-child(4),
    .bk__tb td:nth-child(4) {
      width: 19%;
    }

    .bk__tb th,
    .bk__tb td {
      padding: 5px 4px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* 手机上藏掉单位，四列表头才塞得下（不藏会跟隔壁列叠在一起） */
    .bk__tb .u {
      display: none;
    }

    .bk__tb .nm {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .bk__foot {
      font-size: 12px;
    }
  }
</style>

<style is:global>
  /* 搜索结果由 JS 创建，拿不到作用域标记，只能写全局 */
  .sr__wrap {
    margin-top: 12px;
