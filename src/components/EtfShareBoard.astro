---
import ShareTable from './ShareTable.astro';
import FlowChart from './FlowChart.astro';
import FlowTable from './FlowTable.astro';
import RunStatus from './RunStatus.astro';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

/**
 * embedded = true 表示内嵌在栏目页里，此时不重复渲染返回链接和大标题
 * （栏目页本身已经有 h1 了），只有独立页 /etf-share/ 才显示完整头部。
 */
interface Props {
  embedded?: boolean;
}
const { embedded = false } = Astro.props;

/**
 * ETF 份额看板。
 *
 * 数据全部来自构建时读的 latest.json（由 scripts/etf-share.mjs 每天生成），
 * 页面本身不发请求，纯静态。
 *
 * 注意：这里用 process.cwd()（项目根）而不是 import.meta.url——
 * Astro 构建时后者会被改写成别的路径，existsSync 直接 false，页面就空了。
 */

const dataPath = join(process.cwd(), 'src', 'data', 'etf-share', 'latest.json');
const histPath = join(process.cwd(), 'src', 'data', 'etf-share', 'history.json');

let data: any = null;
if (existsSync(dataPath)) {
  try {
    data = JSON.parse(readFileSync(dataPath, 'utf8'));
  } catch {
    data = null;
  }
}

let history: any = null;
if (existsSync(histPath)) {
  try {
    history = JSON.parse(readFileSync(histPath, 'utf8'));
  } catch {
    history = null;
  }
}

const rows: any[] = data?.rows ?? [];
const hasPrice = !!data?.hasPrice;

/**
 * 规模门槛（亿元），与 scripts/etf-share.mjs 的 MIN_SCALE 保持一致。
 * 每天按最新规模重算，所以涨过 10 亿自动进来、缩下去自动退出。
 */
const MIN_SCALE = 10;

/** 与脚本一致：反直觉榜要有绝对额门槛，否则全是小 ETF */
const bigEnough = (r: any) => (r.amt != null ? Math.abs(r.amt) >= 5 : Math.abs(r.d) >= 1);

// 榜单只看 10 亿以上的；搜索仍然查全量
const pool = rows.filter((r) => (r.sc ?? 0) >= MIN_SCALE);
const poolChanged = pool.filter((r) => r.d !== 0).length;
const changedCount = data?.changed ?? rows.filter((r) => r.d !== 0).length;

// 按金额排，不按份数：不同 ETF 单价差十倍，按份数排会偏袒低价品种
const byAmountDesc = (a: any, b: any) => (b.amt ?? -Infinity) - (a.amt ?? -Infinity);
const byAmountAsc = (a: any, b: any) => (a.amt ?? Infinity) - (b.amt ?? Infinity);

const inflow = pool.filter((r) => r.d > 0).sort(byAmountDesc).slice(0, 12);
const outflow = pool.filter((r) => r.d < 0).sort(byAmountAsc).slice(0, 12);
const upRedeem = pool
  .filter((r) => r.chg != null && r.chg > 0 && r.d < 0 && bigEnough(r))
  .sort((a, b) => (a.amt ?? a.d) - (b.amt ?? b.d))
  .slice(0, 10);
const downBuy = pool
  .filter((r) => r.chg != null && r.chg < 0 && r.d > 0 && bigEnough(r))
  .sort((a, b) => (b.amt ?? b.d) - (a.amt ?? a.d))
  .slice(0, 10);
const streak = pool
  .filter((r) => r.d > 0 && r.st >= 3)
  .sort((a, b) => b.st - a.st)
  .slice(0, 10);

/** 宽基篮子（按指数加总，配置见 src/data/etf-share/baskets.json） */
const baskets: any[] = data?.baskets ?? [];
const basketAmount = baskets.reduce((s: number, b: any) => s + (b.amt || 0), 0);

/** 份额单日变化 ≥11% 的，列出来供人工核对（折算还是大额申赎，看公告才能定） */
const anomalies: any[] = (data?.anomalies ?? []).slice(0, 30);
const industries: any[] = data?.industries ?? [];

const [, mm, dd] = (data?.date || '---- -- --').split('-');
const dateLabel = mm ? `${Number(mm)}月${Number(dd)}日` : '';

const n2 = (v: number) => (v > 0 ? '+' : '') + v.toFixed(2);
---


  <section class="screen">
    <div class="wrap sc">
      <header class="sc__head">
        {!embedded && <a class="sc__back" href="/columns/etf-share/">← ETF份额</a>}
        {!embedded && <h1 class="sc__title">ETF 份额看板</h1>}
      </header>

      {data && <RunStatus date={data.date} total={data.total} partial={data.partial} />}

      {/* 深市还没发布时给个明确交代，否则读者会以为净流入偏小是市场本身如此 */}
      {data?.partial ? (
        <p class="scope is-partial">
          <strong>深市份额还没发布。</strong>
          上交所已公布，深交所按规则次日盘前才出，所以这一版只有沪市 {rows.filter((r: any) => r.m === 'sh').length} 只，
          深市约 780 只没算进来，<strong>净流入会偏小</strong>。明早深市到了会自动覆盖成完整数据。
        </p>
      ) : null}

      {data && (
        <>
          {history && <FlowChart data={history} />}
          {history && <FlowTable />}

          {baskets.length > 0 && (
            <section class="bk">
              <div class="bk__head">
                <h2 class="bk__h">指数篮子 <span class="blk__date">{data.date}</span></h2>
              </div>

              <div class="bk__grid">
                {baskets.map((b: any) => (
                  <details class="bk__card">
                    <summary class="bk__sum">
                      <div class="bk__name">
                        {b.name}
                        <span class="bk__n">{b.n} 只</span>
                      </div>
                      <div class={`bk__v ${b.amt >= 0 ? 'up' : 'down'}`}>
                        {n2(b.amt)}
                        <span class="bk__u">亿</span>
                        {/* 强度：净流入 / 规模。沪深300 盘子 5900 亿、中证1000 才 1000 亿，
                            只看金额会误判成"大盘买得多"，摊到规模上才看得出谁更猛 */}
                        {b.s > 0 && (
                          <span class="bk__pct">
                            {b.amt >= 0 ? '+' : ''}
                            {((b.amt / b.s) * 100).toFixed(2)}%
                          </span>
                        )}
                      </div>
                      <div class="bk__scale">
                        篮子规模 {Math.round(b.s)} 亿
                        <span class="bk__more">点开看成分</span>
                      </div>
                    </summary>
                    {/* 手机屏幕窄，四列放不下，套一层横向滚动而不是让它顶出卡片 */}
                    <div class="bk__tbwrap">
                      <table class="bk__tb">
                        <thead>
                          <tr>
                            <th>代码</th>
                            <th>名称</th>
                            <th class="r">
                              净流入<span class="u">(亿元)</span>
                            </th>
                            <th class="r">
                              规模<span class="u">(亿元)</span>
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          {(b.members || []).map((m: any) => (
                            <tr>
                              <td class="code">{m.c}</td>
                              <td class="nm">{m.n}</td>
                              <td class={`r amt ${m.amt > 0 ? 'up' : m.amt < 0 ? 'down' : 'dim'}`}>
                                {m.amt === 0 ? '—' : (m.amt > 0 ? '+' : '') + m.amt.toFixed(2)}
                              </td>
                              <td class="r dim">{m.s.toFixed(2)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}

          {industries.length > 0 && (
            <section class="ind">
              <div class="ind__head">
                <h2 class="bk__h">行业资金流 <span class="blk__date">{data.date}</span></h2>
              </div>
              <div class="bk__grid">
                {industries.map((ind: any) => (
                  <details class="bk__card">
                    <summary class="bk__sum">
                      <div class="bk__name">
                        {ind.name}
                        <span class="bk__n">{ind.n} 只</span>
                      </div>
                      <div class={`bk__v ${ind.flow >= 0 ? 'up' : 'down'}`}>
                        {n2(ind.flow)}
                        <span class="bk__u">亿</span>
                        {ind.scale > 0 && (
                          <span class="bk__pct">
                            {ind.flow >= 0 ? '+' : ''}
                            {ind.strength.toFixed(2)}%
                          </span>
                        )}
                      </div>
                      <div class="bk__scale">
                        行业规模 {ind.scale} 亿
                        <span class="bk__more">点开看成分</span>
                      </div>
                    </summary>
                    <div class="bk__tbwrap">
                      <table class="bk__tb">
                        <thead>
                          <tr>
                            <th>代码</th>
                            <th>名称</th>
                            <th class="r">净流入<span class="u">(亿元)</span></th>
                            <th class="r">规模<span class="u">(亿元)</span></th>
                          </tr>
                        </thead>
                        <tbody>
                          {(ind.members || []).map((m: any) => (
                            <tr>
                              <td class="code">{m.c}</td>
                              <td class="nm">{m.n}</td>
                              <td class={`r amt ${(m.amt ?? 0) > 0 ? 'up' : (m.amt ?? 0) < 0 ? 'down' : 'dim'}`}>
                                {m.amt == null ? '—' : (m.amt > 0 ? '+' : '') + m.amt.toFixed(2)}
                              </td>
                              <td class="r dim">{m.sc.toFixed(2)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}

          {/* 份额异动清单：把 ≥11% 的全部摆出来，交给人工判断 */}          {anomalies.length > 0 && (
            <details class="an" open>
              <summary class="an__sum">
                <span class="an__ttl">份额异动清单 <span class="blk__date">{data.date}</span></span>
                <span class="an__n">{anomalies.length} 只</span>
                <span class="an__more"></span>
              </summary>
              <p class="an__d">
                单日份额变化 ≥11%，可能是大额申购，也可能是份额折算。标“疑似折算”的已按折算处理（净流入记 0），其余按正常申赎计算，最终以基金公司公告为准。
              </p>
              <div class="an__wrap">
                <table class="an__tb">
                  <thead>
                    <tr>
                      <th>代码</th>
                      <th>名称</th>
                      <th class="r">净流入(亿元)</th>
                      <th class="r">规模(亿元)</th>
                      <th>判定</th>
                    </tr>
                  </thead>
                  <tbody>
                    {anomalies.map((a: any) => (
                      <tr>
                        <td class="code">{a.c}</td>
                        <td class="nm">{a.n}</td>
                        <td class={`r amt ${a.amt == null ? 'dim' : a.amt > 0 ? 'up' : a.amt < 0 ? 'down' : 'dim'}`}>
                          {a.amt == null ? '—' : (a.amt > 0 ? '+' : '') + a.amt}
                        </td>
                        <td class="r dim">{a.sc}</td>
                        <td class="an__tag">
                          {a.sp ? <span class="an__badge is-split">折算</span> : <span class="an__badge">正常</span>}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}

          {/* 搜索是全量 987 行，静态渲染太重，交给 JS 过滤 */}
          <div class="sr">
            <label class="sr__label" for="q">查单只</label>
            <input
              class="sr__input"
              id="q"
              type="search"
              placeholder="代码或名称，例如 510300 / 沪深300"
              autocomplete="off"
            />
            <div class="sr__hint" id="sr-hint"></div>
            <div class="sr__wrap" id="sr-wrap" hidden>
              <table class="sr__table">
                <thead>
                  <tr>
                    <th>代码</th>
                    <th>名称</th>
                    <th class="r">净流入(亿元)</th>
                    <th class="r">规模(亿元)</th>
                  </tr>
                </thead>
                <tbody id="sr-body"></tbody>
              </table>
            </div>
          </div>

          {inflow.length > 0 && (
            <section class="blk">
              <h2 class="blk__h">净申购 TOP 12 <span class="blk__date">{data.date}</span></h2>
              <ShareTable rows={inflow} hasPrice={hasPrice} showStreak />
            </section>
          )}

          {outflow.length > 0 && (
            <section class="blk">
              <h2 class="blk__h">净赎回 TOP 12 <span class="blk__date">{data.date}</span></h2>
              <ShareTable rows={outflow} hasPrice={hasPrice} showStreak />
            </section>
          )}

          {upRedeem.length > 0 && (
            <section class="blk">
              <h2 class="blk__h">涨了，份额却在减 <span class="blk__date">{data.date}</span></h2>

              <ShareTable rows={upRedeem} hasPrice={hasPrice} />
            </section>
          )}

          {downBuy.length > 0 && (
            <section class="blk">
              <h2 class="blk__h">跌了，份额反而增 <span class="blk__date">{data.date}</span></h2>

              <ShareTable rows={downBuy} hasPrice={hasPrice} showStreak />
            </section>
          )}
        </>
      )}
    </div>
  </section>

  <script type="application/json" id="etf-data" is:inline set:html={JSON.stringify(rows)}></script>


<script>
  const el = document.getElementById('etf-data');
  const input = document.getElementById('q') as HTMLInputElement | null;
  const body = document.getElementById('sr-body');
  const wrap = document.getElementById('sr-wrap');
  const hint = document.getElementById('sr-hint');

  if (el && input && body && wrap && hint) {
    const rows: any[] = JSON.parse(el.textContent || '[]');
    const hasPrice = rows.some((r) => r.amt != null);

    const sign = (v: number | null, suffix = '') =>
      v == null ? '—' : (v > 0 ? '+' : '') + v.toFixed(2) + suffix;
    const tone = (v: number | null) => (v == null || v === 0 ? '' : v > 0 ? 'up' : 'down');

    const render = (list: any[]) => {
      body.innerHTML = '';
      for (const r of list) {
        const tr = document.createElement('tr');
        // 列与其它表格保持一致：代码 / 名称 / 净流入 / 规模
        tr.innerHTML =
          `<td class="code">${r.c}</td><td>${r.n}</td>` +
          `<td class="r ${tone(r.amt)}">${sign(r.amt)}</td>` +
          `<td class="r dim">${r.sc != null ? r.sc.toFixed(1) : '—'}</td>`;
        body.appendChild(tr);
      }
    };

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        wrap.hidden = true;
        hint.textContent = '';
        return;
      }
      const hit = rows.filter((r) => r.c.includes(q) || r.n.toLowerCase().includes(q));
      wrap.hidden = hit.length === 0;
      hint.textContent = hit.length ? `匹配 ${hit.length} 只，显示前 30 只` : '没找到这只 ETF';
      render(hit.slice(0, 30));
    });
  }
</script>

<style>
  /* ===== 行业资金流 ===== */
  .ind {
    margin-bottom: 30px;
  }

  .ind__head {
    margin-bottom: 10px;
  }

  .ind__wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .ind__tb {
    width: 100%;
    min-width: 340px;
    border-collapse: collapse;
    font-size: 13px;
  }

  .ind__tb th,
  .ind__tb td {
    padding: 7px 10px;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    white-space: nowrap;
  }

  .ind__tb th {
    background: var(--thead-fill);
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }

  .ind__tb tbody tr:last-child td {
    border-bottom: 0;
  }

  .ind__tb .r {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .ind__tb .amt {
    font-weight: 700;
  }

  .ind__tb .dim {
    color: var(--muted);
  }

  .ind__n {
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .ind__tb {
      font-size: 10.5px;
      table-layout: fixed;
    }

    .ind__tb th,
    .ind__tb td {
      padding: 5px 4px;
    }

    .ind__tb th {
      font-size: 10px;
      letter-spacing: -0.02em;
    }

    .ind__tb th:nth-child(1), .ind__tb td:nth-child(1) { width: 22%; }
    .ind__tb th:nth-child(2), .ind__tb td:nth-child(2) { width: 12%; }
    .ind__tb th:nth-child(3), .ind__tb td:nth-child(3) { width: 22%; }
    .ind__tb th:nth-child(4), .ind__tb td:nth-child(4) { width: 24%; }
    .ind__tb th:nth-child(5), .ind__tb td:nth-child(5) { width: 20%; }
  }

  .sc {
    padding: 28px 0 calc(48px + var(--tabbar-h, 0px));
  }

  .sc__back {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }

  .sc__back:hover {
    color: var(--accent);
  }

  .sc__title {
    margin: 10px 0 8px;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .sc__lead {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  /* 更新时间说明：别让读者以为数据没在更新 */
  .sc__meta {
    margin: 6px 0 0;
    font-size: 12px;
    color: var(--text-dim);
    opacity: 0.75;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 22px 0 14px;
  }

  .stat {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card-bg);
  }

  .stat__k {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .stat__v {
    font-size: 22px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .stat__u {
    margin-left: 4px;
    font-size: 12px;
    color: var(--muted);
  }

  /* 红涨绿跌，跟国内看盘软件一致 */
  .up {
    color: var(--up);
  }

  .down {
    color: var(--down);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 26px;
  }

  .split__item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 14px;
    color: var(--muted);
  }

  /* 宽基篮子 */
  .bk {
    margin-bottom: 26px;
  }

  .bk__head {
    margin-bottom: 12px;
  }

  .bk__h {
    margin: 0 0 4px;
    font-size: 17px;
  }

  .bk__sub {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
  }

  .bk__grid {
    display: grid;
    /* 篮子从 6 个变 7 个，写死 3 列会让最后一行只剩一个，改成自适应 */
    grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
    gap: 10px;
  }

  .bk__card {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card-bg);
  }

  /* 展开后占满整行，成分表才放得下 */
  .bk__card[open] {
    grid-column: 1 / -1;
    border-color: var(--accent-border);
  }

  .bk__sum {
    cursor: pointer;
    list-style: none;
  }

  .bk__sum::-webkit-details-marker {
    display: none;
  }

  .bk__more {
    margin-left: 8px;
    color: var(--accent);
  }

  /* 成分表在手机上放不下，横向滚动；min-width 保证列不被挤成一条 */
  .bk__tbwrap {
    margin-top: 12px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .bk__tb {
    width: 100%;
    min-width: 340px;
    border-collapse: collapse;
    font-size: 13px;
  }

  .bk__tb th,
  .bk__tb td {
    padding: 7px 10px;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    white-space: nowrap;
  }

  .bk__tb th {
    background: var(--thead-fill);
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }

  .bk__tb tbody tr:last-child td {
    border-bottom: 0;
  }

  .bk__tb .r {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* 净流入是排序依据，加粗一点和规模区分开 */
  .bk__tb .amt {
    font-weight: 700;
  }

  .bk__tb .code {
    font-family: var(--font-mono);
    color: var(--text-dim);
  }

  .bk__tb .dim {
    color: var(--muted);
  }

  .bk__name {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  /* 强度百分比：跟在大字金额后面，小一号，别抢主数字的注意力 */
  .bk__pct {
    margin-left: 6px;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    opacity: 0.85;
  }

  .bk__n {
    font-size: 11px;
    font-weight: 400;
    color: var(--muted);
  }

  .bk__v {
    font-size: 24px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .bk__u {
    font-size: 13px;
