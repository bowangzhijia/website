---
/**
 * 资金流明细表：日 / 月 / 季 / 年 四档汇总，可导出 CSV（Excel 直接打开）。
 *
 * 为什么要有：柱子看的是趋势，看不清具体数字；而且很多人习惯把数据拉下来
 * 自己算。表格提供精确值和导出，柱子提供形态，两件事分开做。
 *
 * 数据同样来自 history.json，前端聚合——月度以上都是按日累加出来的，
 * 不额外存一份，避免和日频数据对不上。
 */
---

<section class="ft" data-flowtable>
  <div class="ft__head">
    <h3 class="ft__ttl">资金流明细</h3>
    <div class="ft__ctl">
      <div class="ft__periods">
        <button class="ft__p" type="button" data-p="day" aria-pressed="true">日</button>
        <button class="ft__p" type="button" data-p="month" aria-pressed="false">月</button>
        <button class="ft__p" type="button" data-p="quarter" aria-pressed="false">季</button>
        <button class="ft__p" type="button" data-p="year" aria-pressed="false">年</button>
      </div>
      <button class="ft__more" type="button" data-more hidden>展开</button>
      <button class="ft__dl" type="button" data-download>下载 Excel</button>
    </div>
  </div>

  <div class="ft__wrap">
    <table class="ft__tb">
      <thead>
        <tr data-thead></tr>
      </thead>
      <tbody data-tbody>
        <tr>
          <td colspan="8" class="ft__empty">加载中…</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="ft__foot">
    <span class="ft__hint" data-hint></span>
  </div>

  <p class="ft__note">
    金额单位亿元，均为估算净流入（份额变化 × 当日收盘价）。日频数据可下载为 CSV，Excel、WPS 都能直接打开。
  </p>
</section>

<script>
  const root = document.querySelector('[data-flowtable]') as HTMLElement | null;

  if (root) {
    /** 只统计六大宽基，创新药和美股不算在内 */
    const BROAD = ['hs300', 'sz50', 'zz500', 'zz1000', 'kc50', 'cyb'];
    const SHOW_N = 15;

    const thead = root.querySelector('[data-thead]') as HTMLElement;
    const tbody = root.querySelector('[data-tbody]') as HTMLElement;
    const hint = root.querySelector('[data-hint]') as HTMLElement;
    const more = root.querySelector('[data-more]') as HTMLButtonElement;
    const dl = root.querySelector('[data-download]') as HTMLButtonElement;
    const pbtns = [...root.querySelectorAll('[data-p]')] as HTMLButtonElement[];

    let dates: string[] = [];
    let names: string[] = [];
    let cols: number[][] = []; // 每个宽基一列
    let agg: number[] = [];
    let period: 'day' | 'month' | 'quarter' | 'year' = 'day';
    let expanded = false;

    const n2 = (v: number) => (Math.round(v * 100) / 100).toFixed(2);
    const signed = (v: number) => (v > 0 ? '+' : '') + n2(v);

    /** 把日期归到「月 / 季 / 年」的桶里 */
    const bucketOf = (d: string): string => {
      if (period === 'month') return d.slice(0, 7);
      if (period === 'year') return d.slice(0, 4);
      if (period === 'quarter') {
        const m = Number(d.slice(5, 7));
        return `${d.slice(0, 4)} Q${Math.ceil(m / 3)}`;
      }
      return d;
    };

    /** 按当前周期聚合，返回 { labels, rows }，倒序（新的在前） */
    function aggregate(): { labels: string[]; rows: number[][] } {
      const order: string[] = [];
      const idx = new Map<string, number>();
      const sums: number[][] = [];

      for (let i = 0; i < dates.length; i++) {
        const k = bucketOf(dates[i]);
        let j = idx.get(k);
        if (j === undefined) {
          j = order.length;
          idx.set(k, j);
          order.push(k);
          sums.push(new Array(cols.length + 1).fill(0));
        }
        for (let c = 0; c < cols.length; c++) sums[j][c] += cols[c][i] || 0;
        sums[j][cols.length] += agg[i] || 0;
      }

      const labels: string[] = [];
      const rows: number[][] = [];
      for (let i = order.length - 1; i >= 0; i--) {
        labels.push(order[i]);
        rows.push(sums[i].map((v) => Math.round(v * 100) / 100));
      }
      return { labels, rows };
    }

    function render() {
      const { labels, rows } = aggregate();

      thead.innerHTML =
        '<th>日期</th>' + names.map((n) => `<th class="r">${n}</th>`).join('') + '<th class="r">合计</th>';

      const list = expanded ? rows : rows.slice(0, SHOW_N);
      tbody.innerHTML = list
        .map((r, i) => {
          let html = `<tr><td class="ft__d">${labels[i]}</td>`;
          for (let c = 0; c < r.length; c++) {
            const v = r[c];
            const cls = c === r.length - 1 ? 'ft__sum' : '';
            html += `<td class="r ${cls} ${v > 0 ? 'up' : v < 0 ? 'down' : 'dim'}">${
              v === 0 ? '—' : signed(v)
            }</td>`;
          }
          return html + '</tr>';
        })
        .join('');

      hint.textContent = `共 ${labels.length} 条，显示 ${list.length} 条`;
      more.hidden = rows.length <= SHOW_N;
      more.textContent = expanded ? '折叠' : '展开';
    }

    function toCSV() {
      const { labels, rows } = aggregate();
      const head = ['日期', ...names, '合计'];
      const lines = [head.join(',')];
      for (let i = 0; i < labels.length; i++) {
        lines.push([labels[i], ...rows[i].map((v) => v.toFixed(2))].join(','));
      }
      // BOM 是为了让 Excel 正确识别 UTF-8，否则中文乱码
      return '\uFEFF' + lines.join('\r\n');
    }

    function download() {
      const csv = toCSV();
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      const tag = period === 'day' ? '每日' : period === 'month' ? '每月' : period === 'quarter' ? '每季' : '每年';
      a.href = URL.createObjectURL(blob);
      a.download = `ETF资金流_${tag}_${dates[dates.length - 1] || ''}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }

    pbtns.forEach((b) => {
      b.addEventListener('click', () => {
        period = b.dataset.p as typeof period;
        expanded = false;
        pbtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        render();
      });
    });

    more.addEventListener('click', () => {
      expanded = !expanded;
      render();
    });

    dl.addEventListener('click', download);

    (async () => {
      try {
        const res = await fetch('/data/etf-share/history.json');
        if (!res.ok) throw new Error('load failed');
        const data = await res.json();

        dates = data.flowDates || [];
        agg = data.aggregate || [];

        const list = (data.baskets || []).filter((b: any) => BROAD.includes(b.id));
        names = list.map((b: any) => b.name);
        cols = list.map((b: any) => b.flow || []);

        if (!dates.length) {
          tbody.innerHTML = '<tr><td colspan="8" class="ft__empty">暂无数据</td></tr>';
          return;
        }
        render();
      } catch {
        tbody.innerHTML = '<tr><td colspan="8" class="ft__empty">数据加载失败，刷新页面重试</td></tr>';
      }
    })();
  }
</script>

<style>
  .ft {
    margin: 22px 0 0;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card-bg);
  }

  .ft__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .ft__ttl {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .ft__ctl {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .ft__periods {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .ft__p {
    padding: 4px 10px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    font-family: var(--font);
    cursor: pointer;
  }

  .ft__p[aria-pressed='true'] {
    background: var(--accent);
    color: #fff;
    font-weight: 600;
  }

  .ft__dl {
    padding: 5px 11px;
    border: 1px solid var(--accent-border);
    border-radius: 8px;
    background: transparent;
    color: var(--accent);
    font-size: 12px;
    font-family: var(--font);
    cursor: pointer;
  }

  .ft__dl:hover {
    background: var(--accent-tint);
  }

  .ft__wrap {
    /* 限定高度让表头能粘住：只在页面里滚，表头会跟着滚走 */
    max-height: 480px;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .ft__tb {
    width: 100%;
    min-width: 640px;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 13px;
  }

  .ft__tb th,
  .ft__tb td {
    padding: 7px 10px;
    border-bottom: 1px solid var(--hairline);
    white-space: nowrap;
    text-align: left;
  }

  /*
   * 表头和日期列用 :global 选择器。
   * 表头是 JS 动态创建的（thead.innerHTML = ...），拿不到 Astro 的作用域属性，
   * 普通 scoped 规则根本匹配不上——这是这个项目已经踩过的坑。
   */
  :global(.ft__tb th) {
    background: linear-gradient(var(--thead-fill), var(--thead-fill)), var(--surface);
    background-color: var(--surface);
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    position: sticky;
    top: 0;
    z-index: 2;
  }

  /*
   * 日期列也钉住。
   * 表格有十几列，横向滑到右边时如果日期列跟着走，就对不上是哪一天的数据了。
   * 左上角那个格子（同时钉顶和钉左）要给最高的层级，否则会被别人盖住。
   */
  :global(.ft__tb th:first-child),
  :global(.ft__tb td:first-child) {
    position: sticky;
    left: 0;
    background-color: var(--surface);
    z-index: 1;
  }

  :global(.ft__tb th:first-child) {
    z-index: 3;
    background: linear-gradient(var(--thead-fill), var(--thead-fill)), var(--surface);
    background-color: var(--surface);
  }

  .ft__tb .r {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .ft__tb .ft__d {
    font-family: var(--font-mono);
    color: var(--text-dim);
  }

  .ft__tb .ft__sum {
    font-weight: 700;
  }

  .ft__tb tbody tr:last-child td {
    border-bottom: 0;
  }

  .ft__tb tbody tr:hover {
    background: var(--hover-fill);
  }

  .ft__empty {
    padding: 20px !important;
    text-align: center !important;
    color: var(--muted);
  }

  .ft__foot {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }

  .ft__hint {
    font-size: 12px;
    color: var(--muted);
  }

  .ft__more {
    /* 在右上角的控制条里，和「下载 Excel」并排，不再自己撑开 */
    padding: 5px 11px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    font-family: var(--font);
    cursor: pointer;
  }

  .ft__more:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .ft__note {
    margin: 10px 0 0;
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
  }

  /* 手机横屏：宽度富余、高度紧张，压缩行高让表格一屏多看几行 */
  @media (orientation: landscape) and (max-height: 560px) {
    .ft {
      margin-top: 12px;
      padding: 11px 13px;
    }

    .ft__head {
      margin-bottom: 8px;
    }

    .ft__tb th,
    .ft__tb td {
      padding: 4px 8px;
    }

    .ft__note {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .ft {
      padding: 12px 13px;
    }

    .ft__ttl {
      font-size: 14px;
    }

    .ft__ctl {
      margin-left: 0;
      width: 100%;
      justify-content: space-between;
    }

    .ft__tb {
      font-size: 11.5px;
    }

    .ft__tb th,
    .ft__tb td {
      padding: 5px 7px;
    }
  }
</style>
