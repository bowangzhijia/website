---
/**
 * 文章编辑区，两种用法：
 *   mode="edit"（默认）—— 文章页上改这一篇
 *   mode="new"        —— 栏目页上写一篇新的，栏目已经定好
 *
 * 关键：它**不是浮层**，而是一段普通的页面内容。
 * 打开时把页面原本的内容（标了 data-view 的那块）藏起来，
 * 网站顶栏、底部标签栏都还在——跟文章页长得一样。
 *
 * 平时整段是 hidden 的，只有本机存着 GitHub 令牌时脚本才会把入口亮出来。
 * 访客拿到的页面里这块是隐藏的，而且就算手动打开也提交不了——
 * 发布需要令牌，令牌只在你自己的浏览器里。
 */
import { SECTORS } from '../site.config';
import editScript from '../scripts/inline-edit.js?raw';

interface Props {
  mode?: 'edit' | 'new';
  /** 栏目 id */
  column: string;
  /** 栏目显示名 */
  columnName?: string;
  /** 文件名（不含 .md），就是日期。mode="new" 时不用传 */
  file?: string;
  title?: string;
  summary?: string;
  /** ISO 日期。mode="new" 时留空，由脚本填「今天」 */
  date?: string;
  sectors?: string[];
  /** Markdown 正文原文 */
  body?: string;
}

const {
  mode = 'edit',
  column,
  columnName = '',
  file = '',
  title = '',
  summary = '',
  date = '',
  sectors = [],
  body = '',
} = Astro.props;

const isNew = mode === 'new';

const payload = {
  mode,
  column,
  file,
  title,
  summary,
  date,
  sectors,
  body,
  sectorList: SECTORS.map((sector) => ({ id: sector.id, name: sector.name })),
};

// 正文里可能出现 </script>，转义掉才安全
const json = JSON.stringify(payload).replace(/</g, '\\u003c');
---

<section class="aedit" data-edit-panel hidden>
  <div class="aedit__inner">
    <div class="aedit__top">
      <button class="aedit__back" type="button" data-edit-cancel>
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 5.5 8 12l7 6.5"></path>
        </svg>
        {columnName || '返回'}
      </button>

      <button class="aedit__submit" type="button" data-edit-save>
        {isNew ? '发布' : '保存'}
      </button>
    </div>

    <h1 class="aedit__title">{isNew ? '写新文章' : '编辑这篇文章'}</h1>

    <div class="afield">
      <span class="afield__name">栏目</span>
      <p class="aedit__fixed">{columnName}</p>
    </div>

    <label class="afield">
      <span class="afield__name">标题</span>
      <input type="text" data-edit-title autocomplete="off" />
    </label>

    <label class="afield">
      <span class="afield__name">摘要<span class="afield__opt">可选</span></span>
      <input type="text" data-edit-summary autocomplete="off" placeholder="一句话，显示在列表里" />
    </label>

    <label class="afield">
      <span class="afield__name">日期<span class="afield__opt">决定网址，改了会换文件</span></span>
      <input type="date" data-edit-date />
    </label>

    <div class="afield">
      <span class="afield__name">行业<span class="afield__opt">可多选</span></span>
      <div class="aedit__sectors">
        {
          SECTORS.map((sector) => (
            <label class="asector">
              <input type="checkbox" value={sector.id} data-edit-sector />
              <span>{sector.name}</span>
            </label>
          ))
        }
      </div>
    </div>

    <label class="afield">
      <span class="afield__name">正文<span class="afield__opt">Markdown</span></span>
      <textarea data-edit-body rows="18" spellcheck="false"></textarea>
    </label>

    <p class="aedit__msg" data-edit-msg role="status" aria-live="polite"></p>

    <div class="aedit__foot">
      <button class="aedit__danger" type="button" data-edit-delete hidden={isNew}>删除这篇文章</button>
    </div>
  </div>
</section>

<script type="application/json" id="article-data" set:html={json}></script>
<script is:inline set:html={editScript}></script>

<style>
  /*
   * 整块是普通页面内容，不是浮层：
   * 网站顶栏、底部标签栏都在，跟文章页同一个版心（720px）。
   */
  .aedit {
    flex: 1;
    padding: 34px 0 60px;
  }

  .aedit[hidden] {
    display: none;
  }

  /* 和文章页 .wrap.art__inner 同样的版心宽度，切换时内容不会跳位 */
  .aedit__inner {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
    padding-inline: 22px;
  }

  /* ---------- 顶部一行：返回在左、主操作在右，和文章页一致 ---------- */
  .aedit__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
  }

  /* 纯文字 + 箭头，和文章页/写作台的返回同一种样式 */
  .aedit__back {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 40px;
    margin-left: -6px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .aedit__back:hover {
    color: var(--accent);
  }

  /* 主操作做成圆角胶囊，对应文章页右上角的「编辑这篇」 */
  .aedit__submit {
    flex: none;
    min-height: 40px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 18px var(--accent-glow);
  }

  .aedit__submit:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .aedit__title {
    font-size: clamp(22px, 3vw, 28px);
    letter-spacing: -0.03em;
    margin: 0 0 22px;
  }

  /* ---------- 表单 ---------- */
  .afield {
    display: block;
    margin-bottom: 17px;
  }

  .afield__name {
    display: flex;
    align-items: baseline;
    gap: 7px;
    flex-wrap: wrap;
    margin-bottom: 7px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .afield__opt {
    font-weight: 400;
    letter-spacing: 0;
    color: var(--faint);
  }

  /* 栏目只作告知，不能改 */
  .aedit__fixed {
    margin: 0;
    padding: 11px 14px;
    border-radius: 11px;
    background: var(--chip-fill);
    color: var(--text-dim);
    font-size: 16px;
  }

  .aedit input[type='text'],
  .aedit input[type='date'],
  .aedit textarea {
    width: 100%;
    padding: 11px 14px;
    border-radius: 11px;
    border: 1px solid var(--input-border);
    background: var(--input-bg);
    color: var(--text);
    font-family: inherit;
    /* 16px 是底线：小于它 iOS 聚焦时会把整页放大 */
    font-size: 16px;
    line-height: 1.65;
    outline: none;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .aedit textarea {
    min-height: 340px;
    resize: vertical;
    font-family: var(--font-mono);
    font-size: 14.5px;
  }

  .aedit input:focus,
  .aedit textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  /* ---------- 行业 ---------- */
  .aedit__sectors {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .asector {
    position: relative;
    cursor: pointer;
  }

  .asector input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .asector span {
    display: block;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--chip-fill);
    color: var(--text-dim);
    font-size: 13px;
    line-height: 1.6;
    transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
  }

  .asector input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
  }

  /* ---------- 状态与删除 ---------- */
  .aedit__msg {
    min-height: 20px;
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  .aedit__msg[data-state='ok'] {
    color: var(--down);
  }

  .aedit__msg[data-state='error'] {
    color: var(--up);
  }

  .aedit__foot {
    margin-top: 10px;
  }

  .aedit__danger {
    padding: 9px 16px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--up) 40%, transparent);
    background: transparent;
    color: var(--up);
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
  }

  .aedit__danger:hover {
    background: color-mix(in srgb, var(--up) 10%, transparent);
  }

  .aedit__danger[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .aedit {
      padding: 20px 0 48px;
    }
    .aedit__top {
      margin-bottom: 16px;
    }
  }
</style>
