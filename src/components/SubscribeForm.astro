---
import { SUBSCRIBE } from '../site.config';
---

<form class="sub" data-endpoint={SUBSCRIBE.endpoint} novalidate>
  <label class="sr-only" for="sub-email">邮箱地址</label>
  <input
    id="sub-email"
    name="email"
    type="email"
    inputmode="email"
    autocomplete="email"
    placeholder={SUBSCRIBE.placeholder}
    required
  />
  <button class="btn btn--primary" type="submit">{SUBSCRIBE.button}</button>
</form>
<p class="sub__msg" data-msg role="status" aria-live="polite"></p>

<script is:inline>
  const SUCCESS_TEXT = '订阅成功。';
  const FALLBACK_TEXT = '暂时无法订阅，请稍后再试。';

  document.querySelectorAll('form.sub').forEach((form) => {
    const msg = form.nextElementSibling;
    const input = form.querySelector('input[type="email"]');
    const button = form.querySelector('button');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = (input.value || '').trim();

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.textContent = '请填写有效的邮箱地址。';
        msg.dataset.state = 'error';
        input.focus();
        return;
      }

      button.disabled = true;
      msg.textContent = '';
      msg.dataset.state = '';

      try {
        const res = await fetch(form.dataset.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: location.pathname }),
        });
        if (!res.ok) throw new Error(String(res.status));

        msg.textContent = SUCCESS_TEXT;
        msg.dataset.state = 'ok';
        input.value = '';
      } catch (err) {
        msg.textContent = FALLBACK_TEXT;
        msg.dataset.state = 'error';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .sub {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .sub input {
    flex: 1 1 220px;
    min-width: 0;
    padding: 12px 18px;
    border-radius: 999px;
    border: 1px solid var(--input-border);
    background: var(--input-bg);
    color: var(--text);
    font-size: 15px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .sub input::placeholder {
    color: var(--muted);
  }

  .sub input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .sub__msg {
    min-height: 20px;
    margin: 10px 0 0;
    font-size: 13.5px;
  }

  .sub__msg[data-state='ok'] {
    color: var(--down);
  }

  .sub__msg[data-state='error'] {
    color: var(--up);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    /* iOS 上字号小于 16px 的输入框聚焦时会被自动放大 */
    .sub input {
      font-size: 16px;
    }
  }

  @media (max-width: 520px) {
    .sub button {
      flex: 1 1 100%;
    }
  }
</style>
