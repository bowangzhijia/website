---
import Header from '../components/Header.astro';
import TabBar from '../components/TabBar.astro';
import AdminGate from '../components/AdminGate.astro';
import { SITE } from '../site.config';
import authScript from '../scripts/auth.js?raw';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 页面类型，用于结构化数据 */
  type?: 'website' | 'article';
  publishedTime?: string;
  /** 设为 true 时输出 noindex，让搜索引擎不收录（用于写作台这类工具页） */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

/** 写作台自己带门禁，不再显示右下角齿轮 */
const isWritePage = Astro.url.pathname.startsWith('/write');

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(SITE.ogImage, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : 'WebSite',
  name: SITE.name,
  headline: pageTitle,
  description,
  url: canonical,
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: SITE.author },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />
    <!-- 主题引导：必须早于首屏绘制，否则会出现主题闪烁。默认浅色，无需设置属性 -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('etf-theme') === 'dark') {
            document.documentElement.dataset.theme = 'dark';
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', '#07090e');
          }
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      门禁校验脚本，必须最早加载，供齿轮弹窗和写作台共用。
      这里用 ?raw 直接内联进 HTML：独立文件会被浏览器缓存 4 小时，
      换了密码却拿到旧脚本，就会出现「密码明明对却说不对」。
    -->
    <script is:inline set:html={authScript}></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>

    {/* 必须放在 Header 之外：顶栏的 backdrop-filter 会给 fixed 元素另建包含块 */}
    <TabBar />
    {!isWritePage && <AdminGate />}

    <script is:inline>
      // 滚动出现动画（无 JS 时内容依然可见）
      document.documentElement.classList.add('js-ready');
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // 主题切换
      var root = document.documentElement;
      document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.classList.add('theme-switching');
          if (next === 'dark') {
            root.dataset.theme = 'dark';
          } else {
            delete root.dataset.theme;
          }
          try {
            localStorage.setItem('etf-theme', next);
          } catch (e) {}
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', next === 'dark' ? '#07090e' : '#ffffff');
          btn.setAttribute(
            'aria-label',
            next === 'dark' ? '切换到浅色主题' : '切换到深色主题'
          );
          setTimeout(function () {
            root.classList.remove('theme-switching');
          }, 320);
        });
      });
    </script>

    <!--
      私密栏目口令弹窗。
      点「ETF份额」时不再整页跳走，而是在当前页弹框——
      否则用户一点栏目，整个网站的导航和别人能看的内容都没了。
      直接输网址访问仍然会落到整页口令页（那是兜底），这里只管点击入口。
    -->
    <script is:inline>
      (function () {
        var PATTERN = '/columns/etf-share';
        var shown = false;

        function buildModal(target) {
          var wrap = document.createElement('div');
          wrap.className = 'lockmodal';
          wrap.innerHTML =
            '<div class="lockmodal__box" role="dialog" aria-modal="true" aria-labelledby="lockmodal-t">' +
            '<h2 class="lockmodal__t" id="lockmodal-t">这个栏目是私密的</h2>' +
            '<p class="lockmodal__d">输入口令后可以查看，30 天内免输。</p>' +
            '<input class="lockmodal__i" type="password" placeholder="口令" autocomplete="current-password">' +
            '<div class="lockmodal__err"></div>' +
            '<button class="lockmodal__ok" type="button">进入</button>' +
            '<button class="lockmodal__back" type="button">返回</button>' +
            '</div>';
          document.body.appendChild(wrap);

          var box = wrap.querySelector('.lockmodal__box');
          var input = wrap.querySelector('.lockmodal__i');
          var err = wrap.querySelector('.lockmodal__err');
          var ok = wrap.querySelector('.lockmodal__ok');
          var back = wrap.querySelector('.lockmodal__back');

          function close() {
            if (wrap.parentNode) wrap.parentNode.removeChild(wrap);
            shown = false;
            document.documentElement.style.overflow = '';
          }

          // 点遮罩（弹窗外面）就关掉
          wrap.addEventListener('click', function (e) {
            if (!box.contains(e.target)) close();
          });
          back.addEventListener('click', close);
          document.addEventListener('keydown', function esc(e) {
            if (!wrap.parentNode) {
              document.removeEventListener('keydown', esc);
              return;
            }
            if (e.key === 'Escape') close();
          });

          async function submit() {
            var v = input.value.trim();
            if (!v) return;
            ok.disabled = true;
            err.textContent = '';
            try {
              var r = await fetch('/api/unlock', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password: v }),
              });
              if (r.ok) {
                location.href = target;
                return;
              }
              err.textContent = '口令不对';
            } catch (e) {
              err.textContent = '网络出错，稍后再试';
            }
            ok.disabled = false;
            input.select();
          }

          ok.addEventListener('click', submit);
          input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') submit();
          });

          document.documentElement.style.overflow = 'hidden';
          setTimeout(function () {
            input.focus();
          }, 60);
          shown = true;
        }

        document.addEventListener('click', async function (e) {
          var a = e.target.closest ? e.target.closest('a') : null;
          if (!a || !a.getAttribute('href')) return;
          if (a.getAttribute('href').indexOf(PATTERN) === -1) return;

          e.preventDefault();
          if (shown) return;

          // 解过锁就直接进，不打扰
          try {
            var r = await fetch('/api/status');
            var j = await r.json();
            if (j && j.unlocked) {
              location.href = a.href;
              return;
            }
          } catch (err) {
            /* 查询失败就当没解锁，弹框兜住 */
          }
          buildModal(a.href);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* 仅在 JS 可用时才隐藏带动画的元素，避免无 JS 环境白屏 */
  html:not(.js-ready) .reveal {
    opacity: 1;
    transform: none;
  }

  /* ===== 私密栏目口令弹窗 ===== */
  .lockmodal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
    animation: lockmodal-in 0.16s ease;
  }

  @keyframes lockmodal-in {
    from {
      opacity: 0;
    }
  }

  .lockmodal__box {
    width: min(92vw, 330px);
    padding: 24px 22px 18px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card-bg);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.28);
  }

  .lockmodal__t {
    margin: 0 0 6px;
    font-size: 17px;
    color: var(--text);
  }

  .lockmodal__d {
    margin: 0 0 16px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  .lockmodal__i {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text);
    font-size: 15px;
    font-family: var(--font);
    outline: none;
  }

  .lockmodal__i:focus {
    border-color: var(--accent-border);
  }

  .lockmodal__err {
    min-height: 18px;
    margin-top: 8px;
    font-size: 12px;
    color: var(--up);
  }

  .lockmodal__ok {
    width: 100%;
    padding: 10px;
    border: 0;
    border-radius: 9px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font);
    cursor: pointer;
  }

  .lockmodal__ok:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .lockmodal__back {
    width: 100%;
    margin-top: 8px;
    padding: 9px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    font-family: var(--font);
    cursor: pointer;
  }

  .lockmodal__back:hover {
    color: var(--text);
    border-color: var(--text-dim);
  }
</style>
