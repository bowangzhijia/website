---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="退订" description="退订邮件通知。">
  <section class="screen">
    <div class="wrap screen__inner">
      <div class="box">
        <h1 class="box__title">退订</h1>
        <p class="box__lead" data-lead>正在检查链接…</p>

        <button class="btn btn--primary btn--block" type="button" data-btn hidden>
          确认退订
        </button>

        <p class="box__status" data-status role="status" aria-live="polite"></p>

        <a class="box__back" href="/">← 返回首页</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var token = (new URLSearchParams(location.search).get('token') || '')
      .trim()
      .toLowerCase();
    var lead = document.querySelector('[data-lead]');
    var btn = document.querySelector('[data-btn]');
    var status = document.querySelector('[data-status]');

    function showLead(text) {
      lead.textContent = text;
    }

    if (!/^[0-9a-f]{16,64}$/.test(token)) {
      showLead('这个链接无效，可能不完整。请从邮件里重新点一次退订链接。');
      return;
    }

    showLead('确认要退订吗？退订后不会再收到任何邮件。');
    btn.hidden = false;

    btn.addEventListener('click', function () {
      btn.disabled = true;
      status.textContent = '';
      status.dataset.state = '';

      fetch('/api/unsubscribe?token=' + encodeURIComponent(token), {
        method: 'POST',
      })
        .then(function (res) {
          return res.json().then(function (data) {
            return { status: res.status, data: data };
          });
        })
        .then(function (r) {
          if (r.data && r.data.ok) {
            showLead('已退订。');
            status.textContent = '以后不会再收到邮件了。想重新订阅，回首页留一次邮箱即可。';
            status.dataset.state = 'ok';
            btn.hidden = true;
          } else if (r.data && r.data.error === 'NOT_FOUND') {
            showLead('这个退订链接已失效。');
            status.textContent = '可能你已经退订过了。';
            status.dataset.state = 'ok';
            btn.hidden = true;
          } else {
            showLead('退订失败。');
            status.textContent = '请稍后再试，或到留言页告诉我。';
            status.dataset.state = 'error';
            btn.disabled = false;
          }
        })
        .catch(function () {
          showLead('退订失败。');
          status.textContent = '网络异常，请稍后再试。';
          status.dataset.state = 'error';
          btn.disabled = false;
        });
    });
  })();
</script>

<style>
  .screen {
    flex: 1;
    display: flex;
    padding: 30px 0;
  }

  .screen__inner {
    margin-block: auto;
    width: 100%;
  }

  .box {
    max-width: 460px;
    margin: 0 auto;
    text-align: center;
    padding: 34px 28px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--card-bg);
  }

  .box__title {
    font-size: clamp(24px, 3.4vw, 30px);
    letter-spacing: -0.03em;
    margin-bottom: 10px;
  }

  .box__lead {
    color: var(--text-dim);
    font-size: 15px;
    margin-bottom: 22px;
  }

  .box__status {
    min-height: 20px;
    margin: 12px 0 0;
    font-size: 13.5px;
    color: var(--muted);
  }

  .box__status[data-state='ok'] {
    color: var(--down);
  }

  .box__status[data-state='error'] {
    color: var(--up);
  }

  .box__back {
    display: inline-block;
    margin-top: 22px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .box__back:hover {
    color: var(--accent-soft);
  }

  @media (max-width: 620px) {
    .box {
      padding: 26px 20px;
    }
  }
</style>
