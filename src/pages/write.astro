---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COLUMNS, SECTORS } from '../site.config';

/** 只有 feed 型栏目接受投稿 */
const targets = COLUMNS.filter((column) => column.kind === 'feed');
const defaultColumn = targets[0]?.id ?? 'redian';
---

<BaseLayout title="写作台" description="发布新文章" noindex>
  <!-- ---------- 门禁 ---------- -->
  <div class="lock" data-lock>
    <div class="wrap lock__inner">
      <p class="lock__title">请填写生日</p>
      <input class="lock__input" type="date" data-lock-input />
      <p class="lock__msg" data-lock-msg></p>
      <button class="btn btn--primary lock__btn" type="button" data-lock-submit>进入</button>
    </div>
  </div>

  <div class="write" data-app hidden>
    <div class="wrap write__inner">
      <div class="write__top">
        <a class="write__back" href="/">← 回网站</a>
        <button class="write__out" type="button" data-signout>退出设置</button>
      </div>
      <h1 class="write__title">写作台</h1>
      <p class="write__hint">
        填完点发布，约 1 分钟后网站更新。内容自动存在这台设备上，关掉页面也不会丢。
      </p>

      <div class="perm">
        <div class="perm__row">
          <span class="perm__label">永久入口</span>
          <code data-perm-link></code>
          <button class="btn btn--mini" type="button" data-copy-perm>复制</button>
        </div>
        <p class="perm__tip">
          把这个地址<strong>存成手机书签</strong>，以后点书签直接进，<strong>不用再填生日</strong>。<br />
          （浏览器有时会自动清掉本地记录，但书签不会——这是最稳的方式）
        </p>
      </div>

      <!-- ---------- 使用说明 ---------- -->
      <details class="help">
        <summary class="help__summary">使用说明（忘了怎么弄就看这里）</summary>

        <div class="help__body">
          <h3 class="help__h">怎么进这个页面</h3>
          <ul class="help__ul">
            <li><strong>手机</strong>：点桌面上的「写作」图标（没有就往下看「添加到主屏幕」）</li>
            <li><strong>电脑</strong>：浏览器输入 <code>bowangzhijia.com/write/</code></li>
          </ul>

          <h3 class="help__h">第一次用：设置令牌</h3>
          <p class="help__p">
            这个页面要一把「钥匙」才能发布，这把钥匙叫<strong>令牌</strong>。只需要设置一次。
          </p>
          <ol class="help__ol">
            <li>打开 <code>github.com/settings/personal-access-tokens/new</code></li>
            <li>
              按这个填：
              <div class="help__kv">
                <div><span>Token name</span><b>write-from-phone</b></div>
                <div><span>Expiration</span><b>1 year</b></div>
                <div><span>Repository access</span><b>Only select → bowangzhijia/website</b></div>
                <div><span>Permissions</span><b>Contents → Read and write</b></div>
              </div>
            </li>
            <li>点下面的 <strong>Generate token</strong>，复制出现的那串 <code>github_pat_…</code></li>
            <li>回到本页面，点顶部「GitHub 令牌」→ 粘贴 → 点「保存」</li>
          </ol>
          <p class="help__warn">
            ⚠️ 令牌<strong>只显示一次</strong>，建议复制到手机的密码管理器或备忘录里存好。忘了就重新生成一个。
          </p>

          <h3 class="help__h">日常发布</h3>
          <ol class="help__ol">
            <li>填<strong>标题</strong>（日期会自动填今天）</li>
            <li>点<strong>行业按钮</strong>（可多选，用于网站上的筛选）</li>
            <li>写<strong>正文</strong></li>
            <li>点<strong>发布</strong>，等 1 分钟网站就更新了</li>
          </ol>

          <h3 class="help__h">正文怎么写</h3>
          <p class="help__p">用这三个符号就够了，也可以用上面的快捷按钮插入：</p>
          <div class="help__kv">
            <div><span><code>## </code> 加两个井号</span><b>小标题</b></div>
            <div><span><code>- </code> 减号加空格</span><b>清单一条</b></div>
            <div><span><code>**文字**</code></span><b>加粗</b></div>
          </div>
          <p class="help__p">换行直接按回车就行。写错了不要紧，改完再发一次会问你是否覆盖。</p>

          <h3 class="help__h">添加到主屏幕</h3>
          <ul class="help__ul">
            <li><strong>iPhone</strong>：Safari 打开本页 → 底部「分享」按钮 →「添加到主屏幕」</li>
            <li><strong>安卓</strong>：Chrome 打开本页 → 右上角「⋮」→「添加到主屏幕」</li>
          </ul>

          <h3 class="help__h">常见问题</h3>
          <div class="help__faq">
            <p><b>提示「请先设置 GitHub 令牌」</b>——令牌没保存成功，或者换了浏览器、清了浏览记录。重新粘贴一次。</p>
            <p><b>提示「令牌无效或已过期」</b>——去 GitHub 重新生成一个，把旧的删掉。</p>
            <p><b>提示「令牌权限不足」</b>——生成令牌时 Contents 权限要选 <code>Read and write</code>。</p>
            <p><b>发布成功但网站没变</b>——等 2 分钟。还没变就去 <code>github.com/bowangzhijia/website/actions</code> 看构建是不是失败了。</p>
            <p><b>换了手机</b>——重新粘贴一次令牌。存在密码管理器里就能找到，找不到就重新生成一个。</p>
            <p><b>别人打开这个页面能发布吗</b>——不能。他的令牌代表他自己，对你的仓库没有权限。</p>
          </div>
        </div>
      </details>

      <!-- ---------- 令牌 ---------- -->
      <div class="box">
        <button class="box__head" type="button" data-toggle-token aria-expanded="false">
          <span class="box__label">GitHub 令牌</span>
          <span class="box__state" data-token-state>未设置</span>
        </button>
        <div class="box__body" data-token-body hidden>
          <p class="box__note">
            只需填一次，存在本机浏览器里，不会上传到任何地方。留空则无法发布。
          </p>
          <div class="row">
            <input id="token" type="password" autocomplete="off" placeholder="github_pat_…" />
            <button class="btn btn--ghost" type="button" data-save-token>保存</button>
            <button class="btn btn--ghost" type="button" data-clear-token>清除</button>
          </div>
        </div>
      </div>

      <!-- ---------- 正文表单 ---------- -->
      <div class="field">
        <label class="field__label" for="f-col">栏目</label>
        <select id="f-col">
          {targets.map((column) => <option value={column.id}>{column.name}</option>)}
        </select>
      </div>

      <div class="field">
        <label class="field__label" for="f-title">标题</label>
        <input id="f-title" type="text" placeholder="9月28日 · 半导体和机器人" />
      </div>

      <div class="field">
        <label class="field__label" for="f-date">日期</label>
        <input id="f-date" type="date" />
      </div>

      <div class="field">
        <label class="field__label" for="f-summary">摘要<span class="field__opt">可选</span></label>
        <input id="f-summary" type="text" placeholder="一句话，显示在列表里" />
      </div>

      <div class="field">
        <span class="field__label">行业<span class="field__opt">可多选，用于筛选</span></span>
        <div class="sectors">
          {
            SECTORS.map((sector) => (
              <label class="sector">
                <input type="checkbox" value={sector.id} data-sector />
                <span>{sector.name}</span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="field">
        <span class="field__label">
          正文
          <button class="btn btn--mini" type="button" data-insert="## ">小标题</button>
          <button class="btn btn--mini" type="button" data-insert="- ">清单</button>
          <button class="btn btn--mini" type="button" data-insert="**粗体**">加粗</button>
        </span>
        <textarea
          id="f-body"
          rows="14"
          placeholder={'## 半导体\n\n- 消息内容（来源：xxx公告）\n\n## 机器人\n\n- 消息内容'}></textarea>
      </div>

      <button class="btn btn--primary btn--publish" type="button" data-publish>发布</button>
      <p class="status" data-status role="status" aria-live="polite"></p>

      <!-- ---------- 文章管理 ---------- -->
      <details class="manage">
        <summary class="help__summary">文章管理（编辑 / 删除已发布的文章）</summary>
        <div class="manage__body">
          <button class="btn btn--ghost" type="button" data-load-list>加载文章列表</button>
          <ul class="manage__list" data-list></ul>
          <p class="manage__msg" data-manage-msg></p>
        </div>
      </details>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    // ---------- 配置（这些不是机密，可以公开）----------
    var OWNER = 'bowangzhijia';
    var REPO = 'website';
    var BRANCH = 'main';
    var DIR = 'src/content/posts';
    var TOKEN_KEY = 'bowang-write-token';
    var DRAFT_KEY = 'bowang-write-draft';

    var $ = function (sel) {
      return document.querySelector(sel);
    };

    var elToken = $('#token');
    var elTokenBody = $('[data-token-body]');
    var elTokenState = $('[data-token-state]');
    var elCol = $('#f-col');
    var elTitle = $('#f-title');
    var elDate = $('#f-date');
    var elSummary = $('#f-summary');
    var elBody = $('#f-body');
    var elSectors = Array.prototype.slice.call(document.querySelectorAll('[data-sector]'));
    var elBtn = $('[data-publish]');
    var elStatus = $('[data-status]');

    // ---------- 令牌 ----------
    function getToken() {
      try {
        return localStorage.getItem(TOKEN_KEY) || '';
      } catch (e) {
        return '';
      }
    }

    function refreshTokenState() {
      var t = getToken();
      elTokenState.textContent = t ? '已设置' : '未设置';
      elTokenState.dataset.ok = t ? '1' : '0';
      if (t) {
        elTokenBody.hidden = true;
        elToken.placeholder = '已保存（重新粘贴可覆盖）';
      }
    }

    $('[data-toggle-token]').addEventListener('click', function () {
      elTokenBody.hidden = !elTokenBody.hidden;
      this.setAttribute('aria-expanded', String(!elTokenBody.hidden));
      if (!elTokenBody.hidden && getToken()) elToken.value = '';
    });

    $('[data-save-token]').addEventListener('click', function () {
      var v = elToken.value.trim();
      if (!v) {
        setStatus('请先粘贴令牌', 'error');
        return;
      }
      try {
        localStorage.setItem(TOKEN_KEY, v);
      } catch (e) {}
      elToken.value = '';
      refreshTokenState();
      setStatus('令牌已保存在这台设备上', 'ok');
    });

    $('[data-clear-token]').addEventListener('click', function () {
      try {
        localStorage.removeItem(TOKEN_KEY);
      } catch (e) {}
      refreshTokenState();
      setStatus('已清除令牌', '');
    });

    // ---------- 草稿 ----------
    function todayISO() {
      var d = new Date();
      var m = String(d.getMonth() + 1).padStart(2, '0');
      var day = String(d.getDate()).padStart(2, '0');
      return d.getFullYear() + '-' + m + '-' + day;
    }

    function collect() {
      return {
        column: elCol.value,
        title: elTitle.value,
        date: elDate.value,
        summary: elSummary.value,
        body: elBody.value,
        sectors: elSectors.filter(function (c) {
          return c.checked;
        }).map(function (c) {
          return c.value;
        }),
      };
    }

    function apply(data) {
      if (!data) return;
      if (data.column) elCol.value = data.column;
      if (data.title) elTitle.value = data.title;
      if (data.date) elDate.value = data.date;
      if (data.summary) elSummary.value = data.summary;
      if (data.body) elBody.value = data.body;
      if (Array.isArray(data.sectors)) {
        elSectors.forEach(function (c) {
          c.checked = data.sectors.indexOf(c.value) >= 0;
        });
      }
    }

    var saveTimer = null;
    function saveDraftSoon() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(function () {
        try {
          localStorage.setItem(DRAFT_KEY, JSON.stringify(collect()));
        } catch (e) {}
      }, 400);
    }

    // 初始化：恢复草稿
    elDate.value = todayISO();
    try {
      apply(JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null'));
    } catch (e) {}
    refreshTokenState();

    ['input', 'change'].forEach(function (evt) {
      document.querySelector('.write__inner').addEventListener(evt, saveDraftSoon);
    });

    // ---------- 工具 ----------
    function setStatus(text, state) {
      elStatus.textContent = text || '';
      elStatus.dataset.state = state || '';
    }

    function yamlStr(s) {
      return '"' + String(s || '').replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"';
    }

    function base64(str) {
      var bytes = new TextEncoder().encode(str);
      var bin = '';
      for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return btoa(bin);
    }

    function buildMarkdown(d) {
      var fm = ['---'];
      fm.push('title: ' + yamlStr(d.title));
      if (d.summary) fm.push('summary: ' + yamlStr(d.summary));
      fm.push('date: ' + d.date);
      fm.push('column: ' + d.column);
      fm.push('sectors: [' + d.sectors.join(', ') + ']');
      fm.push('---');
      return fm.join('\n') + '\n\n' + (d.body || '').trim() + '\n';
    }

    function apiUrl(path) {
      return 'https://api.github.com/repos/' + OWNER + '/' + REPO + '/contents/' + path;
    }

    function headers() {
      return {
        authorization: 'Bearer ' + getToken(),
        accept: 'application/vnd.github+json',
        'x-github-api-version': '2022-11-28',
      };
    }

    // ---------- 插入语法 ----------
    document.querySelectorAll('[data-insert]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-insert');
        var start = elBody.selectionStart;
        var end = elBody.selectionEnd;
        var value = elBody.value;
        // 行首插入，保证标题/清单生效
        var atLineStart = start === 0 || value.charAt(start - 1) === '\n';
        var insert = (atLineStart ? '' : '\n') + text;
        elBody.value = value.slice(0, start) + insert + value.slice(end);
        elBody.selectionStart = elBody.selectionEnd = start + insert.length;
        elBody.focus();
        saveDraftSoon();
      });
    });

    // ---------- 发布 ----------
    elBtn.addEventListener('click', async function () {
      var d = collect();

      if (!getToken()) {
        setStatus('请先设置 GitHub 令牌（点上面的「GitHub 令牌」）', 'error');
        return;
      }
      if (!d.title.trim()) {
        setStatus('标题不能为空', 'error');
        elTitle.focus();
        return;
      }
      if (!d.date) {
        setStatus('请填写日期', 'error');
        elDate.focus();
        return;
      }
      if (!d.body.trim()) {
        setStatus('正文不能为空', 'error');
        elBody.focus();
        return;
      }

      d.title = d.title.trim();
      d.summary = d.summary.trim();

      elBtn.disabled = true;
      setStatus('正在提交…', '');

      var path = DIR + '/' + d.date + '.md';

      try {
        // 先看这一天的文件是否已存在，存在就带上 sha 覆盖
        var head = await fetch(apiUrl(path) + '?ref=' + BRANCH + '&t=' + Date.now(), {
          headers: headers(),
        });

        var existingSha = null;
        if (head.status === 200) {
          existingSha = (await head.json()).sha;
        } else if (head.status === 401) {
          throw new Error('令牌无效或已过期，请重新设置');
        } else if (head.status === 404) {
          // 正常：这一天的文章还没有
        } else if (head.status === 403) {
          throw new Error('令牌权限不足，需要「Contents 读写」权限');
        }

        if (existingSha) {
          var ok = confirm(d.date + ' 的文章已存在，要用这次的内容覆盖它吗？');
          if (!ok) {
            setStatus('已取消', '');
            elBtn.disabled = false;
            return;
          }
        }

        var payload = {
          message: (existingSha ? '更新：' : '新增：') + d.title,
          content: base64(buildMarkdown(d)),
          branch: BRANCH,
        };
        if (existingSha) payload.sha = existingSha;

        var res = await fetch(apiUrl(path), {
          method: 'PUT',
          headers: Object.assign({ 'content-type': 'application/json' }, headers()),
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          var info = await res.json().catch(function () {
            return {};
          });
          throw new Error(info.message || 'HTTP ' + res.status);
        }

        try {
          localStorage.removeItem(DRAFT_KEY);
        } catch (e) {}

        setStatus('已提交，约 1 分钟后网站更新。', 'ok');
      } catch (err) {
        setStatus('提交失败：' + (err && err.message ? err.message : err), 'error');
      } finally {
        elBtn.disabled = false;
      }
    });

    // ---------- 门禁 ----------
    var lockEl = $('[data-lock]');
    var appEl = $('[data-app]');
    var lockInput = $('[data-lock-input]');
    var lockMsg = $('[data-lock-msg]');
    var lockBtn = $('[data-lock-submit]');

    function showApp() {
      if (lockEl) lockEl.hidden = true;
      if (appEl) appEl.hidden = false;
    }

    function submitLock() {
      if (!window.BowangAuth) {
        lockMsg.textContent = '脚本加载失败，请刷新页面重试';
        lockMsg.dataset.state = 'error';
        return;
      }
      lockBtn.disabled = true;
      lockMsg.textContent = '验证中…';
      lockMsg.dataset.state = '';
      window.BowangAuth.check(lockInput.value).then(function (ok) {
        lockBtn.disabled = false;
        if (ok) {
          window.BowangAuth.mark();
          showApp();
        } else {
          lockMsg.textContent = '日期不对，请重新填写';
          lockMsg.dataset.state = 'error';
        }
      });
    }

    if (lockBtn) {
      lockBtn.addEventListener('click', submitLock);
      lockInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') submitLock();
      });
      if (window.BowangAuth && window.BowangAuth.unlocked()) showApp();
    }

    // ---------- 永久入口 ----------
    var permLink = $('[data-perm-link]');
    if (permLink && window.BowangAuth && window.BowangAuth.permalink) {
      permLink.textContent = window.BowangAuth.permalink();
    }

    var copyPerm = $('[data-copy-perm]');
    if (copyPerm) {
      copyPerm.addEventListener('click', function () {
        var text = permLink ? permLink.textContent : '';
        var done = function () {
          copyPerm.textContent = '已复制';
          setTimeout(function () {
            copyPerm.textContent = '复制';
          }, 1600);
        };
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(done).catch(done);
        } else {
          done();
        }
      });
    }

    var signoutBtn = $('[data-signout]');
    if (signoutBtn) {
      signoutBtn.addEventListener('click', function () {
        if (!confirm('退出后，这台设备下次进入需要重新填生日。确定吗？')) return;
        if (window.BowangAuth) window.BowangAuth.lock();
        location.href = '/';
      });
    }

    // ---------- 文章管理 ----------
    var listEl = $('[data-list]');
    var manageMsg = $('[data-manage-msg]');

    function setManageMsg(text, state) {
      if (!manageMsg) return;
      manageMsg.textContent = text || '';
      manageMsg.dataset.state = state || '';
    }

    async function errText(res) {
      try {
        var j = await res.json();
        return j.message || 'HTTP ' + res.status;
      } catch (e) {
        return 'HTTP ' + res.status;
      }
    }

    function fromBase64(b64) {
      var bin = atob(String(b64).replace(/\n/g, ''));
      var bytes = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return new TextDecoder().decode(bytes);
    }

    /** 把一篇 Markdown 拆成表单字段 */
    function parsePost(content) {
      var m = String(content).match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
      var fm = m ? m[1] : '';
      var body = m ? m[2] : String(content);

      function get(key) {
        var r = fm.match(new RegExp('^' + key + ':\\s*(.*)$', 'm'));
        if (!r) return '';
        return r[1].trim().replace(/^"(.*)"$/, '$1');
      }

      return {
        title: get('title'),
        summary: get('summary'),
        date: get('date'),
        sectors: get('sectors')
          .replace(/[\[\]]/g, '')
          .split(',')
          .map(function (s) {
            return s.trim();
          })
          .filter(Boolean),
        body: body.replace(/^\s*\n/, '').trim(),
      };
    }

    function fillForm(d, fileName) {
      elTitle.value = d.title || '';
      elSummary.value = d.summary || '';
      elDate.value = d.date || fileName.replace(/\.md$/, '');
      elBody.value = d.body || '';
      elSectors.forEach(function (c) {
        c.checked = d.sectors.indexOf(c.value) >= 0;
      });
      saveDraftSoon();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function loadList() {
      if (!getToken()) {
        setManageMsg('请先设置 GitHub 令牌（点上面的「GitHub 令牌」）', 'error');
        return;
      }

      setManageMsg('加载中…', '');
      listEl.innerHTML = '';

      var res = await fetch(apiUrl(DIR) + '?ref=' + BRANCH + '&t=' + Date.now(), {
        headers: headers(),
      });
      if (!res.ok) {
        setManageMsg('加载失败：' + (await errText(res)), 'error');
        return;
      }

      var files = (await res.json()).filter(function (f) {
        return /\.md$/.test(f.name);
      });
      files.sort(function (a, b) {
        return b.name.localeCompare(a.name);
      });
      files = files.slice(0, 30);

      if (!files.length) {
        setManageMsg('还没有任何文章', '');
        return;
      }

      var items = await Promise.all(
        files.map(async function (f) {
          try {
            var r = await fetch(f.url + '?t=' + Date.now(), { headers: headers() });
            var j = await r.json();
            return { name: f.name, sha: f.sha, data: parsePost(fromBase64(j.content)) };
          } catch (e) {
            return { name: f.name, sha: f.sha, data: null };
          }
        })
      );

      items.forEach(function (item) {
        var label = (item.data && item.data.title) || item.name.replace(/\.md$/, '');

        var li = document.createElement('li');
        li.className = 'mitem';

        var info = document.createElement('div');
        info.className = 'mitem__info';
        var b = document.createElement('b');
        b.textContent = label;
        var meta = document.createElement('span');
        var parts = [item.name.replace(/\.md$/, '')];
        if (item.data && item.data.sectors.length) parts.push(item.data.sectors.join(' / '));
        meta.textContent = parts.join('　');
        info.appendChild(b);
        info.appendChild(meta);

        var acts = document.createElement('div');
        acts.className = 'mitem__acts';

        var edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'btn btn--mini';
        edit.textContent = '编辑';
        edit.addEventListener('click', function () {
          if (!item.data) {
            setManageMsg('这篇读取失败了，请重新加载', 'error');
            return;
          }
          fillForm(item.data, item.name);
          setManageMsg('已载入「' + label + '」，改完点上面的「发布」即可覆盖', 'ok');
        });

        var del = document.createElement('button');
        del.type = 'button';
        del.className = 'btn btn--mini btn--danger';
        del.textContent = '删除';
        del.addEventListener('click', async function () {
          if (!confirm('确定删除「' + label + '」吗？\n\n网站约 1 分钟后更新。这一步不可撤销，但 Git 里留有历史记录。'))
            return;
          del.disabled = true;
          setManageMsg('正在删除…', '');
          try {
            var r = await fetch(apiUrl(DIR + '/' + item.name), {
              method: 'DELETE',
              headers: Object.assign({ 'content-type': 'application/json' }, headers()),
              body: JSON.stringify({
                message: '删除：' + label,
                sha: item.sha,
                branch: BRANCH,
              }),
            });
            if (!r.ok) throw new Error(await errText(r));
            li.remove();
            setManageMsg('已删除「' + label + '」，约 1 分钟后网站更新', 'ok');
          } catch (e) {
            del.disabled = false;
            setManageMsg('删除失败：' + (e && e.message ? e.message : e), 'error');
          }
        });

        acts.appendChild(edit);
        acts.appendChild(del);
        li.appendChild(info);
        li.appendChild(acts);
        listEl.appendChild(li);
      });

      setManageMsg('共 ' + items.length + ' 篇（最多列出最近 30 篇）', '');
    }

    var loadBtn = $('[data-load-list]');
    if (loadBtn) {
      loadBtn.addEventListener('click', function () {
        loadList().catch(function (e) {
          setManageMsg('加载失败：' + (e && e.message ? e.message : e), 'error');
        });
      });
    }

    refreshTokenState();
  })();
</script>

