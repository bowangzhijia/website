---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlatformLinks from '../../../components/PlatformLinks.astro';
import SubscribeForm from '../../../components/SubscribeForm.astro';
import MessageForm from '../../../components/MessageForm.astro';
import ContactCard from '../../../components/ContactCard.astro';
import ColumnFeed from '../../../components/ColumnFeed.astro';
import { COLUMNS, PLATFORMS, WELCOME, RISK_NOTE } from '../../../site.config';
import { getPostsByColumn } from '../../../utils/posts';

export function getStaticPaths() {
  return COLUMNS.map((column, index) => ({
    params: { id: column.id },
    props: { column, index },
  }));
}

const { column, index } = Astro.props;

const isMessage = column.kind === 'message';
const isFeed = column.kind === 'feed';
const intro = column.welcome ?? WELCOME;
const accounts =
  isMessage || isFeed ? [] : PLATFORMS.filter((p) => p.column === column.id);

/** feed 型栏目（波王热点）要渲染文章列表 */
const posts = isFeed ? await getPostsByColumn(column.id) : [];
---

<BaseLayout title={column.name} description={column.desc}>
  {
    isFeed ? (
      <section class="feedpage">
        <div class="wrap">
          <header class="feedpage__head">
            <h1 class="feedpage__title">{column.name}</h1>
            <p class="feedpage__tagline">{column.tagline}</p>
            <p class="feedpage__intro">{intro.body}</p>
          </header>

          <ColumnFeed posts={posts} columnId={column.id} />

          <div class="feedpage__sub">
            <SubscribeForm />
          </div>

          <p class="risk">{RISK_NOTE}</p>
        </div>
      </section>
    ) : (
  <section class="screen">
    <div class="wrap screen__inner">
      <div class={`landing${isMessage ? ' landing--single' : ''}`}>
        <div class="left">
          <p class="idx">{String(index + 1).padStart(2, '0')}</p>
          <h1 class="name">{column.name}</h1>
          <p class="tagline">{column.tagline}</p>

          <div class="welcome">
            <p class="welcome__title">{intro.title}</p>
            <p class="welcome__body">{intro.body}</p>
          </div>

          <div id="subscribe">
            {isMessage ? <MessageForm /> : <SubscribeForm />}
          </div>

          {isMessage && <ContactCard />}
        </div>

        {
          accounts.length > 0 && (
            <div class="right">
              <h2 class="block__title">平台账号</h2>
              <PlatformLinks items={accounts} />
            </div>
          )
        }
      </div>

      <p class="risk">{RISK_NOTE}</p>
    </div>
  </section>
    )
  }
</BaseLayout>

<style>
  /* 撑满剩余高度并垂直居中，正常屏幕上不出现滚动条 */
  .screen {
    flex: 1;
    display: flex;
    padding: 26px 0;
  }

  .screen__inner {
    margin-block: auto;
    width: 100%;
  }

  .landing {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 48px;
    align-items: start;
  }

  /* 留言栏只要一栏，居中 */
  .landing--single {
    grid-template-columns: minmax(0, 540px);
    justify-content: center;
  }

  /* ---------- 左栏 ---------- */
  .idx {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0 0 8px;
  }

  .name {
    font-size: clamp(25px, 3.4vw, 34px);
    letter-spacing: -0.03em;
    margin: 0 0 5px;
  }

  .tagline {
    color: var(--accent);
    font-weight: 600;
    font-size: 14.5px;
    margin: 0 0 20px;
  }

  .welcome {
    border-left: 2px solid var(--accent);
    padding-left: 15px;
    margin-bottom: 20px;
  }

  .welcome__title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 5px;
    letter-spacing: -0.01em;
  }

  .welcome__body {
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }

  #subscribe {
    scroll-margin-top: 90px;
  }

  /* ---------- 右栏 ---------- */
  .block__title {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .block__title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .risk {
    margin: 22px 0 0;
    font-size: 12.5px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .landing,
    .landing--single {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .tagline {
      margin-bottom: 16px;
    }
    .welcome {
      margin-bottom: 16px;
    }
  }

  @media (max-width: 640px) {
    .screen {
      padding: 18px 0;
    }
    .idx {
      display: none;
    }
    .name {
      font-size: 24px;
    }
    .tagline {
      font-size: 13.5px;
      margin-bottom: 14px;
    }
    .welcome__title {
      font-size: 15px;
    }
    .welcome__body {
      font-size: 13.5px;
      line-height: 1.65;
    }
    .risk {
      margin-top: 16px;
    }
  }

  /* ---------- feed 型栏目（波王热点）---------- */
  .feedpage {
    flex: 1;
    padding: 40px 0 56px;
  }

  .feedpage__head {
    margin-bottom: 26px;
  }

  .feedpage__title {
    font-size: clamp(24px, 3.2vw, 32px);
    letter-spacing: -0.03em;
    margin: 0 0 5px;
  }

  .feedpage__tagline {
    color: var(--accent);
    font-weight: 600;
    font-size: 14px;
    margin: 0 0 14px;
  }

  .feedpage__intro {
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.75;
    margin: 0;
    max-width: 620px;
  }

  .feedpage__sub {
    max-width: 520px;
    margin: 42px 0 0;
  }

  @media (max-width: 640px) {
    .feedpage {
      padding: 22px 0 40px;
    }
    .feedpage__head {
      margin-bottom: 18px;
    }
    .feedpage__intro {
      font-size: 13.5px;
    }
    .feedpage__sub {
      margin-top: 28px;
    }
  }
</style>
